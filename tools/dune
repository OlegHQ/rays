; Real-browser check of the WGSL kernels (plan P6.3). Needs Google Chrome; not part of runtest.
; Exit 3 means WebGPU is unavailable in that Chrome; a missing node or Chrome is a printed skip.
(rule
 (alias qualification-web)
 (deps web/test/gpu_check.mjs web/test/chrome.mjs web/runtime/gpu.js ../lib/flow_web/test_wgsl.exe
  (glob_files ../lib/flow_web/goldens/*.js))
 (action
  (system "if command -v node >/dev/null 2>&1; then mkdir -p kt && ../lib/flow_web/test_wgsl.exe --write-kernel-table kt && node web/test/gpu_check.mjs kt/kernels.json web/runtime/gpu.js ../lib/flow_web/goldens; else echo 'gpu_check: skipped (node not found)'; fi")))

; End-to-end reload (plan P6.7): the watch server and a page in headless Chrome. Not part of runtest.
(rule
 (alias qualification-web)
 (deps web/test/reload_check.mjs web/test/chrome.mjs %{bin:rays-lisp} ../sketches/flow_vectors/sketch.rays)
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/reload_check.mjs %{bin:rays-lisp} ../sketches/flow_vectors/sketch.rays; else echo 'reload_check: skipped (node not found)'; fi")))

; Real-Chrome check of the presenter (plan P6.4, P6.5): hand-built mark tables with pixel probes, then
; flow_vectors and examples/basic exported, stepped in the browser and compared with the native picture.
(rule
 (alias qualification-web)
 (deps web/test/present_check.mjs web/test/present_e2e.mjs web/test/chrome.mjs web/test/png.mjs
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl lisp/lisp.exe marks_shot.exe
  (source_tree ../sketches/flow_vectors) (source_tree ../examples/basic))
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/present_check.mjs web/runtime && node web/test/present_e2e.mjs lisp/lisp.exe marks_shot.exe .. sketches/flow_vectors examples/basic; else echo 'present_check: skipped (node not found)'; fi")))

