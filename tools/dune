; Marks_scene is private to rays_editor; this tool compiles its own copy, as lib/rays_editor/marks_scene_test does.
(copy_files ../lib/rays_editor/marks_scene.ml)
(copy_files ../lib/rays_editor/marks_scene.mli)

(executable
 (name marks_shot)
 (modules marks_shot marks_scene)
 (libraries web_export flow flow_ir flow_sop flow_gpu sop ogpu rays_execution frame_input rays rays_editor scene_command))

; GPU attribute regions in real Chrome (plan P6.4a): the export places a mark set's regions on the GPU, one device is shared
; by gpu.js and present.js, and the canvas equals the native picture; window counters prove no CPU invoke ran.
(rule
 (alias qualification-web)
 (deps web/test/gpu_marks_e2e.mjs web/test/png.mjs web/test/chrome.mjs
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl lisp/lisp.exe marks_shot.exe
  (source_tree ../sketches/flow_particles_gpu))
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/gpu_marks_e2e.mjs lisp/lisp.exe marks_shot.exe ..; else echo 'gpu_marks_e2e: skipped (node not found)'; fi")))

; Generated-image pixel parity, animation, sharing, static reuse, resize and reload (P6.4b).
(rule
 (alias qualification-web)
 (deps web/test/gpu_images_e2e.mjs web/test/png.mjs web/test/chrome.mjs
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl lisp/lisp.exe marks_shot.exe
  (source_tree ../sketches/flow_contours) (source_tree ../sketches/flow_image_kernel)
  (source_tree ../sketches/flow_shader) (source_tree ../sketches/flow_image)
  (source_tree ../test/sdl3_image_fixtures))
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/gpu_images_e2e.mjs lisp/lisp.exe marks_shot.exe ..; else echo 'gpu_images_e2e: skipped (node not found)'; fi")))

(executable
 (name web_shot)
 (modules web_shot)
 (libraries unix))

; Pixel parity of the served web export in a real browser (plan P6.8): examples/particles at fixed-step frames 1, 30 and 120
; against the native render (marks_shot), through `rays-lisp web --watch` and headless Chrome with WebGPU. Exit 3 means
; WebGPU is unavailable in that Chrome; a missing node or Chrome is a printed skip.
(rule
 (alias qualification-web)
 (deps web/test/web_shot.mjs web/test/png.mjs web/test/chrome.mjs
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl lisp/lisp.exe marks_shot.exe
  (source_tree ../examples/particles))
 (action
  (run ./web_shot.exe lisp/lisp.exe ./marks_shot.exe web/test/web_shot.mjs ../examples/particles 800 600 1 30 120)))

; Plan P6.R: each of the 15 workspaces with a draw graph either opens in headless Chrome (the frame loop runs, no error, a
; non-empty mark table) or is refused at export with its code and span. Printed per workspace.
(rule
 (alias qualification-web)
 (deps web/test/open_all.mjs web/test/chrome.mjs lisp/lisp.exe
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl
  (source_tree ../examples) (source_tree ../sketches))
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/open_all.mjs lisp/lisp.exe .. examples/audio examples/basic examples/drawing examples/file_dialog examples/generative examples/noise examples/particles examples/pxui examples/recursive_rectangles sketches/flow_contours sketches/flow_image sketches/flow_image_kernel sketches/flow_particles_gpu sketches/flow_shader sketches/flow_vectors; else echo 'open_all: skipped (node not found)'; fi")))
