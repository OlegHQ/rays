(workspace metadata_nodes
; Whole-node drafts, not embedded or registered. Native encoded keys and
; canonical aliases are authored here; group pattern failures remain cooked.

(defn metadata_attribute_owner :context value [(raw : text) (allow_any : bool)]
  (let* [token (text/lower (text/trim raw))]
    (case token
      "point" "point" "points" "point"
      "vertex" "vertex" "vertices" "vertex"
      "primitive" "primitive" "primitives" "primitive" "detail" "detail"
      "any" (if allow_any "any" (error "E_PARAM" (str "unknown attribute owner " (text/repr token))))
      "*" (if allow_any "any" (error "E_PARAM" (str "unknown attribute owner " (text/repr token))))
      :else (error "E_PARAM" (str "unknown attribute owner " (text/repr token))))))

(defn metadata_group_owner :context value [(raw : text)]
  (let* [token (text/lower (text/trim raw))]
    (case token
      "point" "point" "points" "point"
      "vertex" "vertex" "vertices" "vertex"
      "primitive" "primitive" "primitives" "primitive"
      "edge" "edge" "edges" "edge" "any" "any" "*" "any"
      :else (error "E_PARAM" (str "unknown group owner " (text/repr token))))))

(defn metadata_group_conflict :context value [(raw : text)]
  (let* [token (text/lower (text/trim raw))]
    (case token "skip" "skip" "error" "error" "overwrite" "overwrite" "union" "union"
      :else (error "E_PARAM" (str "unknown group rename conflict " (text/repr token))))))
(defn metadata_attribute_method :context value [(raw : text)]
  (let* [token (text/lower (text/trim raw))]
    (case token "swap" "swap" "move" "move" "copy" "copy"
      :else (error "E_PARAM" (str "unknown attribute swap method " (text/repr token))))))

(defn metadata_swap_attributes_normalize :context value [(raw : text)]
  (text/table_encode (map (fn [(row : (list text))]
    (if (= (count row) 4)
      (list (metadata_attribute_owner (nth row 0) false) (nth row 1) (nth row 2)
        (metadata_attribute_method (nth row 3)))
      (error "E_PARAM" (str "Attribute Swap rule needs owner, source, destination, and method; got " (count row) " columns"))))
    (text/table_decode raw))))
(defn metadata_group_rename_normalize :context value [(raw : text)]
  (text/table_encode (map (fn [(row : (list text))]
    (if (= (count row) 4)
      (list (metadata_group_owner (nth row 0)) (nth row 1) (nth row 2)
        (metadata_group_conflict (nth row 3)))
      (error "E_PARAM" (str "Group Rename rule needs owner, pattern, replacement, and conflict; got " (count row) " columns"))))
    (text/table_decode raw))))
(defn metadata_group_delete_normalize :context value [(raw : text)]
  (text/table_encode (map (fn [(row : (list text))]
    (if (= (count row) 2) (list (metadata_group_owner (nth row 0)) (nth row 1))
      (error "E_PARAM" (str "Group Delete rule needs owner and pattern, got " (count row) " columns"))))
    (text/table_decode raw))))

(defn metadata_rewrite_validate :context value [(operation : text) (pattern : text) (replacement : text)]
  (let* [message (text/glob_rewrite_error pattern replacement)]
    (if (equal? message "") true (error "E_PARAM" (str operation ": " message)))))

(defnode sop/swap_attributes :label "Swap Attributes" :operation "attribute_swap"
  :category ["Attribute" "Manage"]
  :validate (reduce (fn [valid row]
    (and (metadata_rewrite_validate "sop/swap_attributes" (nth row 1) (nth row 2))
      (metadata_rewrite_validate "sop/swap_attributes" (nth row 2) (nth row 1)))) true (text/table_decode rules))
  [(in0 : geometry)
   (rules : text "" :label "Rules (owner, source, destination, method)" :kind encoded
     :normalize metadata_swap_attributes_normalize)]
  (reduce (fn [geometry row]
    (sop/swap_attr geometry (nth row 1) (nth row 2) :owner (nth row 0) :method (nth row 3))) in0 (text/table_decode rules)))

(defnode sop/group_rename :label "Group Rename" :category ["Group" "Edit"]
  [(in0 : geometry)
   (rules : text "" :label "Rules (owner, pattern, replacement, conflict)" :kind encoded
     :normalize metadata_group_rename_normalize)]
  (reduce (fn [geometry row]
    (sop/rename_group geometry (nth row 1) (nth row 2) :owner (nth row 0) :conflict (nth row 3))) in0 (text/table_decode rules)))

(defnode sop/group_delete :label "Group Delete" :category ["Group" "Edit"]
  [(in0 : geometry)
   (rules : text "" :label "Rules (owner, pattern)" :kind encoded :normalize metadata_group_delete_normalize)
   (delete_unused : bool false :label "Delete unused groups")]
  (let* [selected (reduce (fn [geometry row]
    (sop/delete_group geometry (nth row 1) :owner (nth row 0))) in0 (text/table_decode rules))]
    (sop/delete_group selected "" :unused delete_unused)))

)
