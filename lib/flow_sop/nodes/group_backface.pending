; Whole Group Backfaces draft. A polygon is a backface when its fan normal points away from the
; viewpoint (dot below -64 epsilon), computed in a per-polygon scaled frame.
(defn group_backface_error :context value [(reason : text)]
  (error "invalid_group" "group_backface could not produce valid geometry"
    :cause (str "group_backface [invalid_group]: " reason)))
(defn group_backface_scale :context value [(v : vec3)]
  (max (abs v.x) (max (abs v.y) (abs v.z))))
(defn group_backface_primitive :context value
  [(first : int) (last : int) (kind : int) (positions : (array vec3)) (corners : (array int)) (viewpoint : vec3)]
  (let* [count (int/sub last first)]
    (if (not (int/eq kind 0)) false
      (let* [scale (fold [best 0.0] [i (array/range count :type int)]
                     (max best (group_backface_scale (array/nth positions (array/nth corners (int/add first i))))))]
        (if (= scale 0.0) false
          (let* [anchor (/ (array/nth positions (array/nth corners first)) scale)
                 centroid_sum (fold [total [0.0 0.0 0.0]] [i (array/range count :type int)]
                                (+ total (/ (array/nth positions (array/nth corners (int/add first i))) scale)))
                 normal (fold [total [0.0 0.0 0.0]] [i (array/range (int/sub count 2) :type int)]
                          (let* [u (- (/ (array/nth positions (array/nth corners (int/add (int/add first i) 1))) scale) anchor)
                                 v (- (/ (array/nth positions (array/nth corners (int/add (int/add first i) 2))) scale) anchor)]
                            (+ total [(- (* u.y v.z) (* u.z v.y)) (- (* u.z v.x) (* u.x v.z)) (- (* u.x v.y) (* u.y v.x))])))
                 normal_scale (group_backface_scale normal)]
            (if (= normal_scale 0.0) false
              (let* [centroid (* centroid_sum (/ 1.0 (float count)))
                     view_scale (max scale (group_backface_scale viewpoint))
                     ratio (/ scale view_scale)
                     toward (- (/ viewpoint view_scale) (* centroid ratio))
                     toward_scale (group_backface_scale toward)]
                (if (= toward_scale 0.0) false
                  (let* [n (/ normal normal_scale) w (/ toward toward_scale)]
                    (< (+ (+ (* n.x w.x) (* n.y w.y)) (* n.z w.z)) (* -64.0 2.220446049250313e-16))))))))))))
(defn group_backface_missing :context sop [(geo : geometry) (name : text)]
  (let* [found (group_exists geo "primitive" (if (equal? name "") "x" name))]
    (and (not (equal? name "")) (not found))))
(defn group_backface_finish :context sop
  [(geo : geometry) (name : text) (operation : text) (base_name : text) (fixed : (array int))]
  (if (group_backface_missing geo base_name)
    (group_backface_error (str "Group Backface: missing primitive base group " (text/repr base_name)))
    (if (equal? base_name "")
      (group_publish geo "primitive" name operation fixed)
      (group_publish geo "primitive" name operation
        (exact (map (fn [(a : int) (b : int)] (int/and a b)) fixed
                 (sop/group geo :name base_name :owner "primitive")))))))
(defnode sop/group_backface :label "Group Backfaces" :category ["Group" "Create"]
  [(in0 : geometry)
   (name : text "backface" :label "Group name")
   (viewpoint_x : float 0.0 :label "Viewpoint X" :folder ["Viewpoint"] :min -100 :max 100 :vec3 ["viewpoint" 0])
   (viewpoint_y : float 0.0 :label "Viewpoint Y" :folder ["Viewpoint"] :min -100 :max 100 :vec3 ["viewpoint" 1])
   (viewpoint_z : float 10.0 :label "Viewpoint Z" :folder ["Viewpoint"] :min -100 :max 100 :vec3 ["viewpoint" 2])
   (base : text "" :label "Base group" :folder ["Combine"])
   (merge : text "Replace" :label "Operation" :folder ["Combine"]
     :choices ["Replace" "Union" "Intersection" "Subtract" "Exclusive or"])]
  (let* [viewpoint [viewpoint_x viewpoint_y viewpoint_z]
         base_name (text/trim base)
         operation (case merge "Union" "union" "Intersection" "intersection" "Subtract" "subtract"
                     "Exclusive or" "xor" :else "replace")
         positions (sop/attr in0 :P)
         points (sop/count in0 :points)
         bad (if (int/eq points 0) points
               (array/min (map (fn [(p : vec3) (i : int)]
                 (if (<= (group_backface_scale p) 1.7976931348623157e308) points i))
                 positions (array/range points :type int))))]
    (cond
      (text/blank? name) (group_backface_error "Group Backface: empty output name")
      (> (group_backface_scale viewpoint) 1.7976931348623157e308)
        (group_backface_error "Group Backface: viewpoint must be finite")
      (group_backface_missing in0 base_name)
        (group_backface_error (str "Group Backface: missing primitive base group " (text/repr base_name)))
      (int/lt bad points) (group_backface_error (str "Group Backface: non-finite position at point " bad))
      :else
        (let* [topology (sop/topology in0)
               primitives (sop/count in0 :primitives)
               raw (map (fn [(first : int) (last : int) (kind : int)]
                     (if (group_backface_primitive first last kind positions topology.vertex_points viewpoint) 1 0))
                     (array/slice topology.primitive_offsets 0 primitives)
                     (array/slice topology.primitive_offsets 1 primitives)
                     topology.kinds)]
          (group_backface_finish in0 name operation base_name (exact raw))))))
