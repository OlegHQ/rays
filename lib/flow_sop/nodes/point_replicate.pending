; PARTIAL Point Replicate draft (BLOCKED, see the commit message): the parameter block is complete and matches
; the native descriptor; the body is a stub that returns the input. Not ported: the per-source copy frame of the
; instancing basis (Instance_copy.copy_frames), quasi-stratified radical-inverse sequences, the noise seed derived
; as mixed_seed(context, identity xor 0x6a09e667f3bcc909) (no seed operator can reproduce that salt), the velocity
; and transform-attribute outputs, and the custom shape. The generation half is the point_generate draft.
(defnode sop/point_replicate :label "Point Replicate" :category ["Create" "Points"]
  [(input : geometry)
   (custom_shape : geometry :required false)
   (group : text "" :label "Point group")
   (keep_input : bool false :label "Keep input")
   (points_per_point : float 10.0 :label "Points per point" :min 0 :max 10000 :hard_min 0)
   (scale_attribute : text "" :label "Count scale")
   (context_seed : bool false :label "Use context seed" :folder ["Random"])
   (seed : int 0 :label "Seed" :folder ["Random"] :min 0 :max 9999)
   (id_attribute : text "id" :label "ID attribute" :folder ["Random"])
   (shape : text "Sphere" :label "Shape" :folder ["Shape"] :choices ["Point" "Box" "Sphere" "Disk" "Line" "Custom"])
   (center_x : float 0.0 :label "Center X" :folder ["Shape" "Center"] :min -10 :max 10 :vec3 ["center" 0])
   (center_y : float 0.0 :label "Center Y" :folder ["Shape" "Center"] :min -10 :max 10 :vec3 ["center" 1])
   (center_z : float 0.0 :label "Center Z" :folder ["Shape" "Center"] :min -10 :max 10 :vec3 ["center" 2])
   (size_x : float 1.0 :label "Size X" :folder ["Shape" "Size"] :min 0 :max 10 :hard_min 0 :vec3 ["size" 0])
   (size_y : float 1.0 :label "Size Y" :folder ["Shape" "Size"] :min 0 :max 10 :hard_min 0 :vec3 ["size" 1])
   (size_z : float 1.0 :label "Size Z" :folder ["Shape" "Size"] :min 0 :max 10 :hard_min 0 :vec3 ["size" 2])
   (orientation_x : float 0.0 :label "Rotate X" :folder ["Shape" "Orientation"] :min -3.141592653589793 :max 3.141592653589793 :vec3 ["orientation" 0])
   (orientation_y : float 0.0 :label "Rotate Y" :folder ["Shape" "Orientation"] :min -3.141592653589793 :max 3.141592653589793 :vec3 ["orientation" 1])
   (orientation_z : float 0.0 :label "Rotate Z" :folder ["Shape" "Orientation"] :min -3.141592653589793 :max 3.141592653589793 :vec3 ["orientation" 2])
   (uniform_scale : float 1.0 :label "Uniform scale" :folder ["Shape"] :min 0 :max 10 :hard_min 0)
   (quasi_stratified : bool false :label "Quasi-stratified" :folder ["Random"])
   (velocity_stretch : text "None" :label "Velocity stretch" :folder ["Velocity"] :choices ["None" "Scaled velocity" "Velocity only"])
   (velocity_scale : float 1.0 :label "Velocity scale" :folder ["Velocity"] :min -10 :max 10)
   (inherit_velocity : float 1.0 :label "Inherit velocity" :folder ["Velocity"] :min -10 :max 10)
   (radial_velocity : float 0.0 :label "Radial velocity" :folder ["Velocity"] :min -10 :max 10)
   (use_noise : bool false :label "Enable noise" :folder ["Noise"])
   (noise_amplitude_x : float 0.1 :label "Amplitude X" :folder ["Noise" "Amplitude"] :min 0 :max 10 :vec3 ["noise_amplitude" 0])
   (noise_amplitude_y : float 0.1 :label "Amplitude Y" :folder ["Noise" "Amplitude"] :min 0 :max 10 :vec3 ["noise_amplitude" 1])
   (noise_amplitude_z : float 0.1 :label "Amplitude Z" :folder ["Noise" "Amplitude"] :min 0 :max 10 :vec3 ["noise_amplitude" 2])
   (noise_frequency_x : float 1.0 :label "Frequency X" :folder ["Noise" "Frequency"] :min 0 :max 20 :vec3 ["noise_frequency" 0])
   (noise_frequency_y : float 1.0 :label "Frequency Y" :folder ["Noise" "Frequency"] :min 0 :max 20 :vec3 ["noise_frequency" 1])
   (noise_frequency_z : float 1.0 :label "Frequency Z" :folder ["Noise" "Frequency"] :min 0 :max 20 :vec3 ["noise_frequency" 2])
   (noise_offset_x : float 0.0 :label "Offset X" :folder ["Noise" "Offset"] :min -10 :max 10 :vec3 ["noise_offset" 0])
   (noise_offset_y : float 0.0 :label "Offset Y" :folder ["Noise" "Offset"] :min -10 :max 10 :vec3 ["noise_offset" 1])
   (noise_offset_z : float 0.0 :label "Offset Z" :folder ["Noise" "Offset"] :min -10 :max 10 :vec3 ["noise_offset" 2])
   (noise_roughness : float 0.5 :label "Roughness" :folder ["Noise"] :min 0 :max 1)
   (noise_attenuation : float 1.0 :label "Attenuation" :folder ["Noise"] :min 0 :max 10)
   (noise_turbulence : int 3 :label "Turbulence" :folder ["Noise"] :min 1 :max 12 :hard_min 1)
   (noise_context_seed : bool false :label "Use context noise seed" :folder ["Noise"])
   (noise_seed : int 1 :label "Noise seed" :folder ["Noise"] :min 0 :max 9999)
   (generated_group : text "" :label "Generated group" :folder ["Output"])
   (copy_point_attributes : text "*" :label "Copy point attributes" :folder ["Transfer"])
   (keep_source_attributes : bool false :label "Keep source attributes" :folder ["Transfer"])
   (transform_attributes : text "P" :label "Transform attributes" :folder ["Transfer"])
   (source_point_attribute : text "sourcepoint" :label "Source point" :folder ["Output"])
   (source_index_attribute : text "sourceindex" :label "Source index" :folder ["Output"])]
  input)
