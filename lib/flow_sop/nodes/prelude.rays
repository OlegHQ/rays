; Shared value helpers. Matrices are row-major records and multiply column vectors.
(workspace sop_nodes
  (defmacro setter_constant [geo owner name type constructor value]
    `(if (equal? ~owner "Point")
       (sop/with_attr ~geo ~name (~constructor (sop/count ~geo :points) ~value) :owner "point" :type ~type)
       (if (equal? ~owner "Vertex")
         (sop/with_attr ~geo ~name (~constructor (sop/count ~geo :vertices) ~value) :owner "vertex" :type ~type)
         (if (equal? ~owner "Primitive")
           (sop/with_attr ~geo ~name (~constructor (sop/count ~geo :primitives) ~value) :owner "primitive" :type ~type)
           (sop/with_attr ~geo ~name (~constructor 1 ~value) :owner "detail" :type ~type)))))

  ; Integer floor/ceil keep their existing contract. Guard the eager conversion
  ; branch and preserve signed zero, including ceil of a small negative value.
  (defn float_floor :context value [(value : float)]
    (let* [large (>= (abs value) 4503599627370496.0)
           rounded (float (floor (if large 0.0 value)))]
      (if (or large (= value 0.0)) value rounded)))
  (defn float_ceil :context value [(value : float)]
    (let* [large (>= (abs value) 4503599627370496.0)
           rounded (float (ceil (if large 0.0 value)))]
      (if (or large (= value 0.0)) value
        (if (and (< value 0.0) (= rounded 0.0)) -0.0 rounded))))

  (defn vec3_dot :context value [(left : vec3) (right : vec3)]
    (+ (+ (* left.x right.x) (* left.y right.y)) (* left.z right.z)))
  (defn vec3_cross :context value [(left : vec3) (right : vec3)]
    ; Native FMSUB subtracts the second product from the rounded first product.
    [(fma (* -1.0 left.z) right.y (* left.y right.z))
     (fma (* -1.0 left.x) right.z (* left.z right.x))
     (fma (* -1.0 left.y) right.x (* left.x right.y))])
  ; Vec3.normalize uses a zero-only test and reciprocal multiplication.
  (defn vec3_normalize :context value [(value : vec3)]
    (let* [size (sqrt (vec3_dot value value))
           reciprocal (/ 1.0 (if (= size 0.0) 1.0 size))]
      (if (= size 0.0) [0.0 0.0 0.0] (* value reciprocal))))
  ; Deform's frame construction rescales before taking the length, then divides.
  (defn vec3_normalize_scaled :context value [(value : vec3)]
    (let* [scale (max (abs value.x) (max (abs value.y) (abs value.z)))
           scaled (/ value (if (= scale 0.0) 1.0 scale))
           size (sqrt (vec3_dot scaled scaled))]
      (if (= scale 0.0) [0.0 0.0 0.0]
        (/ scaled (if (= size 0.0) 1.0 size)))))
  ; Native overflow produces an infinite norm and signed zero components.
  ; Preserve Quat.normalize's left-associated sum, 1e-12 threshold and division.
  (defn quat_normalize :context value [(value : vec4)]
    (let* [product_overflow (> (max (max (abs value.x) (abs value.y))
                                  (max (abs value.z) (abs value.w))) 1.3407807929942596e154)
           safe (if product_overflow [0.0 0.0 0.0 0.0] value)
           xx (* safe.x safe.x) yy (* safe.y safe.y)
           zz (* safe.z safe.z) ww (* safe.w safe.w)
           ; Quarter-sized squares keep even the largest four-term sum finite.
           ; Power-of-two scaling preserves overflow-threshold rounding.
           quarter_total (+ (+ (+ (* xx 0.25) (* yy 0.25)) (* zz 0.25)) (* ww 0.25))
           overflow (or product_overflow (>= quarter_total 4.49423283715579e307))
           factor (if overflow 0.0 1.0)
           ; Rescaling the square root is exact above the identity threshold.
           size (* (sqrt quarter_total) 2.0)
           scaled (* value factor)
           small (and (not overflow) (<= size 1e-12))
           numerator (if small [0.0 0.0 0.0 1.0] scaled)]
      (/ numerator (if (<= size 1e-12) 1.0 size))))
  (defn quat_mul :context value [(left : vec4) (right : vec4)]
    [(- (+ (+ (* left.w right.x) (* left.x right.w)) (* left.y right.z)) (* left.z right.y))
     (+ (+ (- (* left.w right.y) (* left.x right.z)) (* left.y right.w)) (* left.z right.x))
     (+ (- (+ (* left.w right.z) (* left.x right.y)) (* left.y right.x)) (* left.z right.w))
     (- (- (- (* left.w right.w) (* left.x right.x)) (* left.y right.y)) (* left.z right.z))])

  (defn mat4_identity :context value []
    {:r0 [1.0 0.0 0.0 0.0] :r1 [0.0 1.0 0.0 0.0]
     :r2 [0.0 0.0 1.0 0.0] :r3 [0.0 0.0 0.0 1.0]})
  (defn mat4_translation :context value [(value : vec3)]
    {:r0 [1.0 0.0 0.0 value.x] :r1 [0.0 1.0 0.0 value.y]
     :r2 [0.0 0.0 1.0 value.z] :r3 [0.0 0.0 0.0 1.0]})
  (defn mat4_scaling :context value [(value : vec3)]
    {:r0 [value.x 0.0 0.0 0.0] :r1 [0.0 value.y 0.0 0.0]
     :r2 [0.0 0.0 value.z 0.0] :r3 [0.0 0.0 0.0 1.0]})
  (defn mat4_rotation_x :context value [(angle : float)]
    (let* [c (cos angle) s (sin angle)]
      {:r0 [1.0 0.0 0.0 0.0] :r1 [0.0 c (* -1.0 s) 0.0]
       :r2 [0.0 s c 0.0] :r3 [0.0 0.0 0.0 1.0]}))
  (defn mat4_rotation_y :context value [(angle : float)]
    (let* [c (cos angle) s (sin angle)]
      {:r0 [c 0.0 s 0.0] :r1 [0.0 1.0 0.0 0.0]
       :r2 [(* -1.0 s) 0.0 c 0.0] :r3 [0.0 0.0 0.0 1.0]}))
  (defn mat4_rotation_z :context value [(angle : float)]
    (let* [c (cos angle) s (sin angle)]
      {:r0 [c (* -1.0 s) 0.0 0.0] :r1 [s c 0.0 0.0]
       :r2 [0.0 0.0 1.0 0.0] :r3 [0.0 0.0 0.0 1.0]}))
  (defn mat4_rotation :context value [(direction : vec3) (angle : float)]
    (let* [axis (vec3_normalize direction) c (cos angle) s (sin angle) d (- 1.0 c)]
      (if (= (vec3_dot axis axis) 0.0) (mat4_identity)
        {:r0 [(+ c (* (* axis.x axis.x) d))
              (- (* (* axis.x axis.y) d) (* axis.z s))
              (+ (* (* axis.x axis.z) d) (* axis.y s)) 0.0]
         :r1 [(+ (* (* axis.y axis.x) d) (* axis.z s))
              (+ c (* (* axis.y axis.y) d))
              (- (* (* axis.y axis.z) d) (* axis.x s)) 0.0]
         :r2 [(- (* (* axis.z axis.x) d) (* axis.y s))
              (+ (* (* axis.z axis.y) d) (* axis.x s))
              (+ c (* (* axis.z axis.z) d)) 0.0]
         :r3 [0.0 0.0 0.0 1.0]})))
  (defn mat4_transpose :context value [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    {:r0 [matrix.r0.x matrix.r1.x matrix.r2.x matrix.r3.x]
     :r1 [matrix.r0.y matrix.r1.y matrix.r2.y matrix.r3.y]
     :r2 [matrix.r0.z matrix.r1.z matrix.r2.z matrix.r3.z]
     :r3 [matrix.r0.w matrix.r1.w matrix.r2.w matrix.r3.w]})
  ; Mat4.mul starts each accumulator at positive zero, unlike a dot product.
  (defn mat4_mul_row :context value [(row : vec4) (right : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    [(fma row.w right.r3.x (fma row.z right.r2.x
       (fma row.y right.r1.x (fma row.x right.r0.x 0.0))))
     (fma row.w right.r3.y (fma row.z right.r2.y
       (fma row.y right.r1.y (fma row.x right.r0.y 0.0))))
     (fma row.w right.r3.z (fma row.z right.r2.z
       (fma row.y right.r1.z (fma row.x right.r0.z 0.0))))
     (fma row.w right.r3.w (fma row.z right.r2.w
       (fma row.y right.r1.w (fma row.x right.r0.w 0.0))))])
  (defn mat4_mul :context value
    [(left : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})
     (right : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    {:r0 (mat4_mul_row left.r0 right) :r1 (mat4_mul_row left.r1 right)
     :r2 (mat4_mul_row left.r2 right) :r3 (mat4_mul_row left.r3 right)})
  (defn mat4_dot4 :context value [(row : vec4) (value : vec4)]
    (+ (+ (+ (* row.x value.x) (* row.y value.y)) (* row.z value.z)) (* row.w value.w)))
  (defn mat4_transform :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (value : vec4)]
    [(mat4_dot4 matrix.r0 value) (mat4_dot4 matrix.r1 value)
     (mat4_dot4 matrix.r2 value) (mat4_dot4 matrix.r3 value)])
  (defn mat4_point_row :context value [(row : vec4) (value : vec3)]
    (+ (+ (+ (* row.x value.x) (* row.y value.y)) (* row.z value.z)) row.w))
  (defn mat4_transform_point :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (value : vec3)]
    (let* [result [(mat4_point_row matrix.r0 value) (mat4_point_row matrix.r1 value)
                  (mat4_point_row matrix.r2 value)]
           w (mat4_point_row matrix.r3 value) raw (<= (abs w) 1e-12)]
      (if raw result (/ result (if raw 1.0 w)))))
  (defn mat4_direction_row :context value [(row : vec4) (value : vec3)]
    (+ (+ (* row.x value.x) (* row.y value.y)) (* row.z value.z)))
  (defn mat4_transform_direction :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (value : vec3)]
    [(mat4_direction_row matrix.r0 value) (mat4_direction_row matrix.r1 value)
     (mat4_direction_row matrix.r2 value)])

  (defn vec4_component :context value [(value : vec4) (index : int)]
    (case index 0 value.x 1 value.y 2 value.z :else value.w))
  ; Partial-pivot Gauss-Jordan, matching Mat4.inverse's first-tie pivot rule.
  ; Empty list denotes singular; a successful inverse is the single list item.
  (defn mat4_inverse :context value [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    (let* [initial (list {:left matrix.r0 :right [1.0 0.0 0.0 0.0]}
                        {:left matrix.r1 :right [0.0 1.0 0.0 0.0]}
                        {:left matrix.r2 :right [0.0 0.0 1.0 0.0]}
                        {:left matrix.r3 :right [0.0 0.0 0.0 1.0]})
           reduced (fold [state {:rows initial :singular false}] [column (range 4)]
             (let* [pivot (fold [best column] [candidate (range (+ column 1) 4)]
                      (if (> (abs (vec4_component (get (nth state.rows candidate) :left) column))
                             (abs (vec4_component (get (nth state.rows best) :left) column)))
                        candidate best))
                    pivot_row (nth state.rows pivot)
                    divisor (vec4_component pivot_row.left column)]
               (if (<= (abs divisor) 1e-12) (assoc state :singular true)
                 (let* [normalized {:left (/ pivot_row.left divisor) :right (/ pivot_row.right divisor)}
                        swapped (for [index (range 4)]
                          (if (= index column) normalized
                            (if (= index pivot) (nth state.rows column) (nth state.rows index))))
                        eliminated (for [row (range 4)]
                          (let* [entry (nth swapped row) factor (vec4_component entry.left column)]
                            (if (= row column) entry
                              {:left (- entry.left (* factor normalized.left))
                               :right (- entry.right (* factor normalized.right))})))]
                   (assoc state :rows eliminated)))))]
      (if reduced.singular (list)
        (list {:r0 (get (nth reduced.rows 0) :right) :r1 (get (nth reduced.rows 1) :right)
               :r2 (get (nth reduced.rows 2) :right) :r3 (get (nth reduced.rows 3) :right)}))))

  (defn rand_mix_index :context value [(value : int)]
    (let* [a (int/xor value (int/shr value 30))
           b (int/mul a 4564476756301768121)
           c (int/xor b (int/shr b 27))
           d (int/mul c 1499779743744070123)]
      (int/xor d (int/shr d 31))))
  (defn rand_at :context value [(seed : int) (index : int)]
    (let* [key (int/xor seed (int/mul (int/add index 1276007651554290947)
                                     2177342782468422677))]
      (/ (float (int/shr (rand_mix_index key) 10)) 9007199254740992.0)))

  ; Reindexing helpers (C.8). Exact integer gather: source[index[i]].
  (defn int_gather :context value [(source : (array int)) (index : (array int))]
    (exact (map (fn [(at : int)] (array/nth source at)) index)))
  ; Owning primitive of every vertex, from the primitive start offsets (without the terminal).
  (defn prim_of_vertex :context value [(starts : (array int)) (vertices : int)]
    (exact (map (fn [(seen : int)] (int/sub seen 1))
      (array/slice (array/scan_sum (array/scatter_add starts (array/int (array/count starts) 1)
                                    (int/add vertices 1))) 1 vertices))))
  ; Edge ancestry CSR for sop/remap. Unique edges are given by endpoints in one point
  ; space (target endpoints already translated to source points, -1 when a point is gone);
  ; a target edge's row holds the source edge with the same endpoints, or is empty.
  (defn edge_ancestry :context value [(source_a : (array int)) (source_b : (array int))
                                      (target_a : (array int)) (target_b : (array int)) (points : int)]
    (let* [found (exact (array/index_of
             (map (fn [(a : int) (b : int)] (int/add (int/mul (min a b) points) (max a b))) source_a source_b)
             (map (fn [(a : int) (b : int)]
                    (if (or (int/lt a 0) (int/lt b 0)) -1 (int/add (int/mul (min a b) points) (max a b))))
               target_a target_b)))
           present (exact (map (fn [(edge : int)] (if (int/ge edge 0) 1 0)) found))]
      {:offsets (array/scan_sum present)
       :values (int_gather found (array/compact present))}))

  ; Group values are {:mask :ordered :indices}; combining follows Group.combine's order algebra
  ; (union/xor: left preference then right; intersection: the ordered operand; subtract: the left).
  (defn group_value_keep :context value [(indices : (array int)) (keep : (array int))]
    (let* [positions (array/compact (map (fn [(i : int)] (array/nth keep i)) indices))]
      (exact (map (fn [(p : int)] (array/nth indices p)) positions))))
  (defn group_value_preferred :context value
    [(g : {:mask (array int) :ordered bool :indices (array int)})]
    (if g.ordered g.indices (array/compact g.mask)))
  (defn group_value_apply :context value
    [(operation : text) (l : {:mask (array int) :ordered bool :indices (array int)})
     (r : {:mask (array int) :ordered bool :indices (array int)})]
    (if (equal? operation "replace") r
      (let* [mask (exact (case operation
                    "union" (map (fn [(a : int) (b : int)] (int/or a b)) l.mask r.mask)
                    "intersection" (map (fn [(a : int) (b : int)] (int/and a b)) l.mask r.mask)
                    "subtract" (map (fn [(a : int) (b : int)] (int/and a (int/sub 1 b))) l.mask r.mask)
                    :else (map (fn [(a : int) (b : int)] (int/xor a b)) l.mask r.mask)))]
        (cond
          (equal? operation "subtract")
            (if l.ordered {:mask mask :ordered true :indices (group_value_keep l.indices mask)}
              {:mask mask :ordered false :indices (array/int 0)})
          (equal? operation "intersection")
            (if (or l.ordered r.ordered)
              {:mask mask :ordered true
               :indices (group_value_keep (group_value_preferred (if l.ordered l r)) mask)}
              {:mask mask :ordered false :indices (array/int 0)})
          :else
            (if (or l.ordered r.ordered)
              {:mask mask :ordered true
               :indices (array/concat (group_value_keep (group_value_preferred l) mask)
                 (group_value_keep (group_value_preferred r)
                   (map (fn [(m : int) (lm : int)] (int/and m (int/sub 1 lm))) mask l.mask)))}
              {:mask mask :ordered false :indices (array/int 0)})))))
  ; Publish a generated mask under a name, merging with an existing group of that
  ; owner and name (publish_merged_selection). A missing group takes the mask, or an
  ; empty one for intersection and subtract.
  (defn group_exists :context sop [(geo : geometry) (owner : text) (name : text)]
    (fold [found false] [probe (array/text 1 name)]
      (int/gt (array/count (sop/group_names geo (text/glob_literal probe) :owner owner)) 0)))
  (defn group_publish :context sop
    [(geo : geometry) (owner : text) (name : text) (merge : text) (generated : (array int))]
    (let* [mine {:mask generated :ordered false :indices (array/int 0)}
           existing (group_exists geo owner name)
           current (if existing
                     (let* [order (sop/group_order geo :name name :owner owner)]
                       {:mask (sop/group geo :name name :owner owner)
                        :ordered order.ordered :indices order.indices})
                     mine)
           result (if existing (group_value_apply merge current mine)
                    (if (or (equal? merge "intersection") (equal? merge "subtract"))
                      {:mask (exact (map (fn [(a : int)] 0) generated)) :ordered false :indices (array/int 0)}
                      mine))]
      (if (equal? owner "edge")
        (sop/with_group geo (exact result.mask) :name name :owner owner)
        (sop/with_group geo (exact result.mask) :name name :owner owner
          :order {:ordered result.ordered :indices (exact result.indices)}))))

  ; Group.boolean publication used by the group nodes (Group_ops.publish_merged_selection).
  ; Ordered existing groups keep Group.combine's order rules; an absent group takes the
  ; generated mask for Replace/Union/Exclusive or and the empty group otherwise.
  (defn group_order_filter :context sop [(sequence : (array int)) (mask : (array int))]
    (let* [keep (exact (map (fn [(i : int)] (array/nth mask i)) sequence))]
      (exact (map (fn [(k : int)] (array/nth sequence k)) (array/compact keep)))))
  (defn group_merge_publish_ordered :context sop
    [(geo : geometry) (owner : text) (name : text) (generated : (array int)) (merge : text)
     (generated_ordered : bool) (generated_order : (array int))]
    (let* [exists (fold [found false] [candidate (sop/group_names geo "*" :owner owner)]
                    (or found (equal? candidate name)))]
      (if (not exists)
        (if (or (equal? merge "Intersection") (equal? merge "Subtract"))
          (sop/with_group geo (exact (map (fn [(g : int)] (int/mul g 0)) generated)) :name name :owner owner)
          (if generated_ordered
            (sop/with_group geo generated :name name :owner owner :order generated_order)
            (sop/with_group geo generated :name name :owner owner)))
        (let* [old (sop/group geo :name name :owner owner)
               combined (exact (case merge
                 "Union" (map (fn [(o : int) (g : int)] (int/or o g)) old generated)
                 "Intersection" (map (fn [(o : int) (g : int)] (int/and o g)) old generated)
                 "Subtract" (map (fn [(o : int) (g : int)] (int/and o (int/sub 1 g))) old generated)
                 "Exclusive or" (map (fn [(o : int) (g : int)] (int/xor o g)) old generated)
                 :else generated))
               ordering (sop/group_order geo :name name :owner owner)
               lseq (if ordering.ordered ordering.indices (array/compact old))
               rseq (if generated_ordered generated_order (array/compact generated))
               fresh (exact (map (fn [(r : int) (o : int)] (int/and r (int/sub 1 o))) combined old))]
          (cond
            (equal? merge "Replace")
              (if generated_ordered
                (sop/with_group geo combined :name name :owner owner :order generated_order)
                (sop/with_group geo combined :name name :owner owner))
            (or (equal? owner "edge") (not (or ordering.ordered generated_ordered)))
              (sop/with_group geo combined :name name :owner owner)
            (or (equal? merge "Union") (equal? merge "Exclusive or"))
              (sop/with_group geo combined :name name :owner owner
                :order (array/concat (group_order_filter lseq combined) (group_order_filter rseq fresh)))
            (equal? merge "Intersection")
              (sop/with_group geo combined :name name :owner owner
                :order (group_order_filter (if ordering.ordered lseq rseq) combined))
            ordering.ordered
              (sop/with_group geo combined :name name :owner owner :order (group_order_filter lseq combined))
            :else (sop/with_group geo combined :name name :owner owner))))))
  (defn group_merge_publish :context sop
    [(geo : geometry) (owner : text) (name : text) (generated : (array int)) (merge : text)]
    (group_merge_publish_ordered geo owner name generated merge false (array/int 0 0)))

  ; Edge multiplicity: how many corners use each unique edge (Topology_index.edge_offsets).
  (defn edge_usage :context sop [(adjacency : {:edge_of_vertex (array int)}) (edge_count : int)]
    (let* [used (array/compact (exact (map (fn [(e : int)] (if (int/ge e 0) 1 0)) adjacency.edge_of_vertex)))
           edges (exact (map (fn [(v : int)] (array/nth adjacency.edge_of_vertex v)) used))]
      (array/scatter_add edges (array/int (array/count edges) 1) edge_count)))

  ; Transform_ops.transform: positions through the matrix (w divide above 1e-12), then every
  ; vec3 point and vertex N through the inverse transpose, renormalised; a singular matrix drops N.
  (defn transform_normals :context sop
    [(geo : geometry) (owner : text) (normal_matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    (if (sop/has_attr geo "N" :owner owner :type vec3)
      (sop/with_attr geo "N"
        (exact (map (fn [(n : vec3)]
          (let* [o (mat4_transform_direction normal_matrix n)
                 length (sqrt (vec3_dot o o))]
            (if (> length 1e-20) (/ o length) [0.0 0.0 0.0])))
          (sop/attr geo "N" :owner owner :type vec3)))
        :owner owner :type vec3)
      geo))
  ; The native per-point loop m0*x + m1*y + m2*z + m3 fuses the second and third products.
  (defn transform_row_fused :context value [(row : vec4) (p : vec3)]
    (+ (fma row.z p.z (fma row.y p.y (* row.x p.x))) row.w))
  (defn transform_point_fused :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (p : vec3)]
    (let* [result [(transform_row_fused matrix.r0 p) (transform_row_fused matrix.r1 p)
                   (transform_row_fused matrix.r2 p)]
           w (transform_row_fused matrix.r3 p)
           raw (<= (abs w) 1e-12)]
      (if raw result (/ result (if raw 1.0 w)))))
  (defn transform_geometry :context sop
    [(geo : geometry) (matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    (let* [moved (sop/with_attr geo :P
                   (exact (map (fn [(p : vec3)] (transform_point_fused matrix p)) (sop/attr geo :P))))
           inverse (mat4_inverse matrix)]
      (if (= (count inverse) 0)
        (sop/delete_attr (sop/delete_attr moved "N" :owner "point") "N" :owner "vertex")
        (transform_normals
          (transform_normals moved "point" (mat4_transpose (nth inverse 0)))
          "vertex" (mat4_transpose (nth inverse 0))))))

  ; Native Vec3.dot (a.x*b.x + a.y*b.y + a.z*b.z) fuses the second and third products on arm64.
  (defn fused_dot :context value [(a : vec3) (b : vec3)]
    (fma a.z b.z (fma a.y b.y (* a.x b.x))))
  (defn fused_normalize :context value [(a : vec3)]
    (let* [size (sqrt (fused_dot a a))]
      (if (= size 0.0) [0.0 0.0 0.0] (* a (/ 1.0 size)))))
  ; Deform.normalize3: rescale by the largest magnitude, then divide by the length.
  ; A zero input gives the zero vector (native None).
  (defn fused_normalize_scaled :context value [(a : vec3)]
    (let* [scale (max (abs a.x) (max (abs a.y) (abs a.z)))
           scaled (/ a (if (= scale 0.0) 1.0 scale))
           size (sqrt (fused_dot scaled scaled))]
      (if (= scale 0.0) [0.0 0.0 0.0] (/ scaled size))))
  ; The point mask of a deformer's group parameter: every point when blank, else the group
  ; promoted to points (any incident member). owner is lowercase point/vertex/primitive/edge.
  (defn deform_mask :context sop [(geo : geometry) (owner : text) (name : text)]
    (if (text/blank? name) (array/int (sop/count geo :points) 1)
      (if (equal? owner "point") (sop/group geo :name name :owner "point")
        (sop/group geo :name name :owner owner :as_owner "point"))))
  (defn deform_group_missing :context sop [(geo : geometry) (owner : text) (name : text)]
    (and (not (text/blank? name))
         (not (fold [found false] [probe (sop/group_names geo "" :owner owner)]
                (or found (equal? probe name))))))
  (defn deform_error :context value [(op : text) (code : text) (reason : text)]
    (error code (str op " could not produce valid geometry")
      :cause (str op " [" code "]: " reason)))

  ; Blast core shared by blast and blast_by_attribute: delete the elements of owner whose
  ; mask entry is 1 (selected) or 0, carrying survivors through sop/remap.
  (defn blast_apply :context sop
    [(in0 : geometry) (owner : text) (kind : text) (mask : (array int)) (selected : bool)
     (compact_points : bool) (policy : text)]
      (let* [points (sop/count in0 :points)
             vertices (sop/count in0 :vertices)
             prims (sop/count in0 :primitives)
             topo (sop/topology in0)
             ; 1 where the element is deleted
             gone_owner (exact (map (fn [(member : int)] (if selected member (int/sub 1 member))) mask))
             by_point (equal? owner "Points")
             by_vertex (equal? owner "Vertices")
             by_primitive (equal? owner "Primitives")
             gone_vertex (cond by_point (int_gather gone_owner topo.vertex_points)
                                by_vertex gone_owner
                                :else (array/int vertices 0))
             gone_sum (array/segment_sum gone_vertex topo.primitive_offsets)
             starts (array/slice topo.primitive_offsets 0 prims)
             ends (array/slice topo.primitive_offsets 1 prims)
             full (exact (map (fn [(first : int) (last : int)] (int/sub last first)) starts ends))
             ; a deleted primitive counts as touched and is always destroyed
             touched_count (if by_primitive gone_owner gone_sum)
             destroy (or by_primitive (equal? policy "Destroy touched primitives"))
             retained_count (exact (map (fn [(size : int) (touched : int) (type : int)]
               (if destroy (if (int/gt touched 0) 0 size)
                 (let* [kept (int/sub size touched)]
                   (if (int/lt kept (if (int/eq type 1) 2 3)) 0 kept))))
               full touched_count topo.kinds))
             prim_map (array/compact (exact (map (fn [(count : int)] (if (int/gt count 0) 1 0)) retained_count)))
             healed (int/gt (array/sum (exact (map (fn [(count : int) (first : int) (last : int)]
                      (if (and (int/gt count 0) (not (int/eq count (int/sub last first)))) 1 0))
                      retained_count starts ends))) 0)
             prim_of_vertex (exact (map (fn [(seen : int)] (int/sub seen 1))
               (array/slice (array/scan_sum (array/scatter_add starts (array/int prims 1) (int/add vertices 1))) 1 vertices)))
             kept_vertex (exact (map (fn [(prim : int) (gone : int)]
               (if (and (int/gt (array/nth retained_count prim) 0) (int/eq gone 0)) 1 0))
               prim_of_vertex gone_vertex))
             vertex_map (array/compact kept_vertex)
             source_points (int_gather topo.vertex_points vertex_map)
             used (exact (map (fn [(uses : int)] (if (int/gt uses 0) 1 0))
                    (array/scatter_add source_points (array/int (array/count source_points) 1) points)))
             gone_point (if by_point gone_owner (array/int points 0))
             keep_point (exact (map (fn [(gone : int) (use : int)]
               (if (and (int/eq gone 0) (or (not compact_points) (int/eq use 1))) 1 0))
               gone_point used))
             point_map (array/compact keep_point)
             retained_points (array/count point_map)]
        (if (and (int/eq retained_points points)
                 (and (int/eq (array/count vertex_map) vertices) (int/eq (array/count prim_map) prims)))
          in0
          (let* [old_to_new (array/scan_sum keep_point)
                 vertex_points (int_gather old_to_new source_points)
                 target (sop/mesh :points (array/vec3 retained_points) :vertex_points vertex_points
                          :primitive_offsets (array/scan_sum (int_gather retained_count prim_map))
                          :kinds (int_gather topo.kinds prim_map))
                 source_edges (sop/edges in0)
                 target_edges (sop/edges target)
                 remapped (sop/remap in0 target
                   :points point_map :vertices vertex_map :primitives prim_map
                   :positions "mapped"
                   :edges (edge_ancestry source_edges.a source_edges.b
                            (int_gather point_map target_edges.a) (int_gather point_map target_edges.b)
                            points))]
            (if healed
              (sop/delete_attr (sop/delete_attr remapped "N" :owner "point") "N" :owner "vertex")
              remapped)))))

  ; Axis frame of the pole-oriented generators (platonic, tube, torus): radial, pole and tangent,
  ; rotated by the rotation order (Plane_generators.normalize_plane_axis rescales before the length).
  (defn gen_normalize :context value [(value : vec3)]
    (let* [scale (max (abs value.x) (max (abs value.y) (abs value.z)))
           x (/ value.x scale) y (/ value.y scale) z (/ value.z scale)
           length (sqrt (fma z z (fma y y (* x x))))]
      [(/ x length) (/ y length) (/ z length)]))
  (defn gen_custom_frame :context value [(axis : vec3)]
    (let* [pole (gen_normalize axis)
           ax (abs pole.x) ay (abs pole.y) az (abs pole.z)
           reference (cond (and (<= ax ay) (<= ax az)) [1.0 0.0 0.0] (<= ay az) [0.0 1.0 0.0] :else [0.0 0.0 1.0])
           projection (fma reference.z pole.z (fma reference.x pole.x (* reference.y pole.y)))
           radial (gen_normalize [(fma (* -1.0 projection) pole.x reference.x)
                                  (fma (* -1.0 projection) pole.y reference.y)
                                  (fma (* -1.0 projection) pole.z reference.z)])]
      {:r radial :p pole
       :t (gen_normalize (vec3_cross radial pole))}))
  (defn gen_frame :context value [(orientation : text) (axis : vec3) (rotation : vec3) (order : text)]
    (let* [
           frame0 (cond (equal? orientation "X axis") {:r [0.0 1.0 0.0] :p [1.0 0.0 0.0] :t [0.0 0.0 -1.0]}
                        (equal? orientation "Y axis") {:r [1.0 0.0 0.0] :p [0.0 1.0 0.0] :t [0.0 0.0 1.0]}
                        (equal? orientation "Z axis") {:r [1.0 0.0 0.0] :p [0.0 0.0 1.0] :t [0.0 -1.0 0.0]}
                        :else (gen_custom_frame axis))
           rotation_zero (and (= rotation.x 0.0) (and (= rotation.y 0.0) (= rotation.z 0.0)))
           mx (mat4_rotation_x rotation.x) my (mat4_rotation_y rotation.y) mz (mat4_rotation_z rotation.z)
           matrix (case order
             "XYZ" (mat4_mul mz (mat4_mul my mx))
             "XZY" (mat4_mul my (mat4_mul mz mx))
             "YXZ" (mat4_mul mz (mat4_mul mx my))
             "YZX" (mat4_mul mx (mat4_mul mz my))
             "ZXY" (mat4_mul my (mat4_mul mx mz))
             :else (mat4_mul mx (mat4_mul my mz)))
           direction (fn [(v : vec3)]
             (if rotation_zero v
               [(+ (fma matrix.r0.x v.x (* matrix.r0.y v.y)) (* matrix.r0.z v.z))
                (+ (fma matrix.r1.x v.x (* matrix.r1.y v.y)) (* matrix.r1.z v.z))
                (+ (fma matrix.r2.x v.x (* matrix.r2.y v.y)) (* matrix.r2.z v.z))]))]
      {:r (direction frame0.r) :p (direction frame0.p) :t (direction frame0.t)}))

  ; Rdk.Deform.resolve_directions without a named attribute: the point N, else the vertex N
  ; averaged onto its points, else the summed polygon area vectors (fan triangles from each
  ; polygon's first vertex, added to every point of the polygon in vertex order).
  (defn deform_area_directions :context sop [(geo : geometry)]
    (let* [topo (sop/topology geo)
           adjacency (sop/adjacency geo)
           positions (sop/attr geo :P)
           vertices (sop/count geo :vertices)
           prims (sop/count geo :primitives)
           points (sop/count geo :points)
           starts (array/slice topo.primitive_offsets 0 prims)
           ends (array/slice topo.primitive_offsets 1 prims)
           contributions (map (fn [(vertex : int) (prim : int)]
             (let* [first (array/nth starts prim)
                    last (array/nth ends prim)
                    a (array/nth positions (array/nth topo.vertex_points first))
                    b (array/nth positions (array/nth topo.vertex_points vertex))
                    c (array/nth positions (array/nth topo.vertex_points
                        (if (int/lt (int/add vertex 1) vertices) (int/add vertex 1) vertex)))
                    u (- b a)
                    v (- c a)]
               (if (and (int/eq (array/nth topo.kinds prim) 0)
                        (and (int/ge vertex (int/add first 1)) (int/le vertex (int/sub last 2))))
                 [(fma (* -1.0 u.z) v.y (* u.y v.z))
                  (fma (* -1.0 u.x) v.z (* u.z v.x))
                  (fma (* -1.0 u.y) v.x (* u.x v.y))]
                 [0.0 0.0 0.0])))
             (array/range vertices :type int) adjacency.primitive_of_vertex)
           faces (array/segment_sum contributions topo.primitive_offsets)
           per_vertex (map (fn [(prim : int)] (array/nth faces prim)) adjacency.primitive_of_vertex)]
      (array/scatter_add topo.vertex_points per_vertex points)))
  (defn deform_default_directions :context sop [(geo : geometry)]
    (cond (sop/has_attr geo "N") (sop/attr geo "N" :type vec3)
          (sop/has_attr geo "N" :owner "vertex")
            (let* [topo (sop/topology geo)
                   count (sop/count geo :points)
                   totals (array/scatter_add topo.vertex_points
                            (sop/attr geo "N" :owner "vertex" :type vec3) count)
                   incidence (array/scatter_add topo.vertex_points
                               (array/int (sop/count geo :vertices) 1) count)]
              (map (fn [(total : vec3) (n : int)]
                (if (int/gt n 1) (* total (/ 1.0 (float n))) total)) totals incidence))
          :else (deform_area_directions geo)))

  ; Ramp text "position:value,..." (Support.decode_parameter_ramp): positions lie in [0,1], start at 0,
  ; strictly increase and end at 1. Blank text is "no knots" and is accepted here.
  (defn ramp_part :context value [(token : text) (index : int)]
    (let* [parts (text/split token ":")]
      (if (int/eq (array/count parts) 2) (text/to_float (array/nth parts index)) {:value 0.0 :valid false})))
  (defn ramp_positions :context value [(raw : text)]
    (exact (map (fn [(token : text)] (let* [r (ramp_part token 0)] r.value)) (text/split raw ","))))
  (defn ramp_values :context value [(raw : text)]
    (exact (map (fn [(token : text)] (let* [r (ramp_part token 1)] r.value)) (text/split raw ","))))
  (defn ramp_ok :context value [(raw : text)]
    (if (text/blank? raw) true
      (let* [tokens (text/split raw ",")
             count (array/count tokens)
             positions (ramp_positions raw)
             good (exact (map (fn [(token : text)]
               (let* [a (ramp_part token 0) b (ramp_part token 1)]
                 (if (and a.valid (and b.valid (and (>= a.value 0.0) (<= a.value 1.0)))) 1 0))) tokens))]
        (and (int/eq (array/sum good) count)
          (and (int/gt count 1)
            (and (= (array/nth positions 0) 0.0) (and (= (array/nth positions (int/sub count 1)) 1.0)
              (int/eq (array/sum (exact (map (fn [(i : int)]
                (if (> (array/nth positions (int/add i 1)) (array/nth positions i)) 1 0))
                (array/range (int/sub count 1) :type int)))) (int/sub count 1)))))))))
  ; Piecewise-linear sample of validated knots at every x of a plane (Attribute_ops ramp_sample). The
  ; segment of each x is found by one pass per knot, so the element kernels stay loop-free.
  (defn ramp_apply :context value [(xs : (array float)) (p : (array float)) (v : (array float))]
    (let* [knots (array/count p)
           count (array/count xs)
           ; counts[e] = number of knots at or below xs[e], summed per element over a flat element x knot grid
           flags (exact (map (fn [(i : int)]
                   (if (<= (array/nth p (int/mod i knots)) (array/nth xs (int/div i knots))) 1 0))
                   (array/range (int/mul count knots) :type int)))
           lows (array/segment_sum flags (exact (map (fn [(e : int)] (int/mul e knots))
                  (array/range (int/add count 1) :type int))))]
      (exact (map (fn [(x : float) (found : int)]
        (let* [step (int/sub found 1)
               low (if (int/lt step 0) 0 (if (int/lt step (int/sub knots 2)) step (int/sub knots 2)))
               x0 (array/nth p low) x1 (array/nth p (int/add low 1))
               y0 (array/nth v low) y1 (array/nth v (int/add low 1))]
          (cond (<= x 0.0) (array/nth v 0)
                (>= x 1.0) (array/nth v (int/sub knots 1))
                :else (fma (/ (- x x0) (- x1 x0)) (- y1 y0) y0))))
        xs lows))))

; Whole PolyLoft draft (the engine is shared with Skin and PolyBridge: the helpers below move to the
; prelude when a second node needs them). Sections are ragged vertex lists; every adjacent pair is aligned
; (closest ends / closest closed points) and zipped. The greedy zipper is sequential per pair, so it runs
; as one `iterate` step per zipper move over all pairs at once (only the move bits are kept), and the
; triangles are rebuilt from prefix sums of the moves. The output is described by arrays, built with
; sop/mesh and carried by sop/remap. The helpers work on whole arrays with their arithmetic inline: the
; checker types every call site again, so few, flat call sites keep the workspace inside its budget.

; ---- robust lengths over guide positions g = {:x :y :z :p} (vertex -> point -> coordinates) ----
; Max-norm of the difference of the two vertices' points.
(defn loft_scales :context value
  [(g : {:x (array float) :y (array float) :z (array float) :p (array int)}) (us : (array int)) (vs : (array int))]
  (exact (map (fn [(u : int) (v : int)]
    (let* [a (array/nth g.p u) b (array/nth g.p v)]
      (max (abs (- (array/nth g.x a) (array/nth g.x b)))
        (max (abs (- (array/nth g.y a) (array/nth g.y b))) (abs (- (array/nth g.z a) (array/nth g.z b)))))))
    us vs)))
; sqrt of the squared normalised components (0 when the vector is zero).
(defn loft_nlens :context value
  [(g : {:x (array float) :y (array float) :z (array float) :p (array int)}) (us : (array int)) (vs : (array int))
   (scales : (array float))]
  (exact (map (fn [(u : int) (v : int) (scale : float)]
    (let* [a (array/nth g.p u) b (array/nth g.p v)]
      (if (= scale 0.0) 0.0
        (let* [x (/ (- (array/nth g.x a) (array/nth g.x b)) scale)
               y (/ (- (array/nth g.y a) (array/nth g.y b)) scale)
               z (/ (- (array/nth g.z a) (array/nth g.z b)) scale)]
          (sqrt (fma z z (fma y y (* x x))))))))
    us vs scales)))
; Poly_loft.robust_length.
(defn loft_dists :context value
  [(g : {:x (array float) :y (array float) :z (array float) :p (array int)}) (us : (array int)) (vs : (array int))]
  (let* [scales (loft_scales g us vs)
         lens (loft_nlens g us vs scales)]
    (exact (map (fn [(s : float) (l : float)] (* s l)) scales lens))))

; Vertex number at `local` along each section (shifted and optionally reversed).
(defn loft_vertices :context value
  [(off : (array int)) (vert : (array int)) (secs : (array int)) (shifts : (array int)) (revs : (array int))
   (locals : (array int))]
  (exact (map (fn [(i : int)]
    (let* [sec (array/nth secs i) shift (array/nth shifts i) rev (array/nth revs i) local (array/nth locals i)
           first (array/nth off sec) count (int/sub (array/nth off (int/add sec 1)) first)
           k (if (int/eq rev 1) (int/mod (int/add (int/sub shift local) count) count)
               (int/mod (int/add shift local) count))]
      (array/nth vert (int/add first k))))
    (array/range (array/count secs) :type int))))

; Poly_loft.non_collinear on triples of vertices (0/1 per triple).
(defn loft_ncs :context value
  [(g : {:x (array float) :y (array float) :z (array float) :p (array int)}) (tol : float)
   (us : (array int)) (vs : (array int)) (ws : (array int))]
  (let* [n (array/count us)
         rows (array/range n :type int)
         pa (exact (map (fn [(u : int)] (array/nth g.p u)) us))
         pb (exact (map (fn [(v : int)] (array/nth g.p v)) vs))
         pc (exact (map (fn [(w : int)] (array/nth g.p w)) ws))
         ; Edge vectors b - a and c - a, then their max-norm scales.
         ux (exact (map (fn [(a : int) (b : int)] (- (array/nth g.x b) (array/nth g.x a))) pa pb))
         uy (exact (map (fn [(a : int) (b : int)] (- (array/nth g.y b) (array/nth g.y a))) pa pb))
         uz (exact (map (fn [(a : int) (b : int)] (- (array/nth g.z b) (array/nth g.z a))) pa pb))
         vx (exact (map (fn [(a : int) (c : int)] (- (array/nth g.x c) (array/nth g.x a))) pa pc))
         vy (exact (map (fn [(a : int) (c : int)] (- (array/nth g.y c) (array/nth g.y a))) pa pc))
         vz (exact (map (fn [(a : int) (c : int)] (- (array/nth g.z c) (array/nth g.z a))) pa pc))
         su (exact (map (fn [(r : int)] (max (abs (array/nth ux r)) (max (abs (array/nth uy r)) (abs (array/nth uz r))))) rows))
         sv (exact (map (fn [(r : int)] (max (abs (array/nth vx r)) (max (abs (array/nth vy r)) (abs (array/nth vz r))))) rows))
         ; Normalised vectors (a zero scale divides by one: those rows are rejected below).
         nux (exact (map (fn [(x : float) (s : float)] (/ x (if (= s 0.0) 1.0 s))) ux su))
         nuy (exact (map (fn [(x : float) (s : float)] (/ x (if (= s 0.0) 1.0 s))) uy su))
         nuz (exact (map (fn [(x : float) (s : float)] (/ x (if (= s 0.0) 1.0 s))) uz su))
         nvx (exact (map (fn [(x : float) (s : float)] (/ x (if (= s 0.0) 1.0 s))) vx sv))
         nvy (exact (map (fn [(x : float) (s : float)] (/ x (if (= s 0.0) 1.0 s))) vy sv))
         nvz (exact (map (fn [(x : float) (s : float)] (/ x (if (= s 0.0) 1.0 s))) vz sv))
         cx (exact (map (fn [(r : int)] (fma (* -1.0 (array/nth nuz r)) (array/nth nvy r) (* (array/nth nuy r) (array/nth nvz r)))) rows))
         cy (exact (map (fn [(r : int)] (fma (* -1.0 (array/nth nux r)) (array/nth nvz r) (* (array/nth nuz r) (array/nth nvx r)))) rows))
         cz (exact (map (fn [(r : int)] (fma (* -1.0 (array/nth nuy r)) (array/nth nvx r) (* (array/nth nux r) (array/nth nvy r)))) rows))
         cross (exact (map (fn [(x : float) (y : float) (z : float)] (sqrt (fma z z (fma y y (* x x))))) cx cy cz))
         ul (exact (map (fn [(x : float) (y : float) (z : float)] (sqrt (fma z z (fma y y (* x x))))) nux nuy nuz))
         vl (exact (map (fn [(x : float) (y : float) (z : float)] (sqrt (fma z z (fma y y (* x x))))) nvx nvy nvz))]
    (exact (map (fn [(r : int)]
      (let* [a (array/nth pa r) b (array/nth pb r) c (array/nth pc r)
             distinct (and (not (int/eq a b)) (and (not (int/eq b c)) (not (int/eq c a))))]
        (if (and distinct (and (> (array/nth su r) 0.0) (and (> (array/nth sv r) 0.0)
              (> (array/nth cross r) (* (* tol (array/nth ul r)) (array/nth vl r)))))) 1 0)))
      rows))))

; A copy of a[start, start + len) (a plain packed array, usable as a map input).
(defn loft_part :context value [(a : (array int)) (start : int) (len : int)]
  (exact (map (fn [(i : int)] (array/nth a (int/add start i))) (array/range len :type int))))

; ---- alignment of every pair: shifts and reversals of both sections ----
(defn loft_align :context sop
  [(g : {:x (array float) :y (array float) :z (array float) :p (array int)})
   (off : (array int)) (vert : (array int)) (closed : (array int))
   (pa : (array int)) (pb : (array int)) (connect : bool) (shift : int)]
  (let* [pairs (array/count pa)
         idx (array/range pairs :type int)
         ac (exact (map (fn [(p : int)] (int/sub (array/nth off (int/add (array/nth pa p) 1)) (array/nth off (array/nth pa p)))) idx))
         bc (exact (map (fn [(p : int)] (int/sub (array/nth off (int/add (array/nth pb p) 1)) (array/nth off (array/nth pb p)))) idx))
         both (exact (map (fn [(p : int)]
                (int/mul (array/nth closed (array/nth pa p)) (array/nth closed (array/nth pb p)))) idx))
         a0 (exact (map (fn [(p : int)] (array/nth vert (array/nth off (array/nth pa p)))) idx))
         a1 (exact (map (fn [(p : int)] (array/nth vert (int/sub (array/nth off (int/add (array/nth pa p) 1)) 1))) idx))
         b0 (exact (map (fn [(p : int)] (array/nth vert (array/nth off (array/nth pb p)))) idx))
         b1 (exact (map (fn [(p : int)] (array/nth vert (int/sub (array/nth off (int/add (array/nth pb p) 1)) 1))) idx))
         ; The four end-to-end distances in one call: ff, fl, lf, ll.
         cands (loft_dists g (array/concat (array/concat a0 a0) (array/concat a1 a1))
                             (array/concat (array/concat b0 b1) (array/concat b0 b1)))
         ; Endpoint alignment: first strictly smaller candidate wins.
         best (exact (map (fn [(p : int)]
                (let* [x0 (array/nth cands p) x1 (array/nth cands (int/add p pairs))
                       x2 (array/nth cands (int/add p (int/mul 2 pairs))) x3 (array/nth cands (int/add p (int/mul 3 pairs)))
                       m1 (if (< x1 x0) x1 x0) m2 (if (< x2 m1) x2 m1)]
                  (if (< x3 m2) 3 (if (< x2 m1) 2 (if (< x1 x0) 1 0))))) idx))
         ; Closest closed points: brute force over every (a, b) vertex pair, lexicographically first minimum.
         use_closed (exact (map (fn [(c : int)] (if connect c 0)) both))
         cps (array/compact use_closed)
         ncp (array/count cps)
         crange (array/range ncp :type int)
         per (exact (map (fn [(k : int)] (int/mul (array/nth ac (array/nth cps k)) (array/nth bc (array/nth cps k)))) crange))
         roff (array/scan_sum per)
         total (array/nth roff ncp)
         cumulative (array/scan_sum (array/scatter_add (array/slice roff 0 ncp) (array/int ncp 1) (int/add total 1)))
         rows (array/range total :type int)
         rk (exact (map (fn [(r : int)] (int/sub (array/nth cumulative (int/add r 1)) 1)) rows))
         row_a (exact (map (fn [(r : int) (k : int)]
                 (let* [p (array/nth cps k) local (int/sub r (array/nth roff k))]
                   (array/nth vert (int/add (array/nth off (array/nth pa p)) (int/div local (array/nth bc p)))))) rows rk))
         row_b (exact (map (fn [(r : int) (k : int)]
                 (let* [p (array/nth cps k) local (int/sub r (array/nth roff k))]
                   (array/nth vert (int/add (array/nth off (array/nth pb p)) (int/mod local (array/nth bc p)))))) rows rk))
         rd (loft_dists g row_a row_b)
         mins (array/segment_min rd roff)
         hit (array/compact (exact (map (fn [(d : float) (k : int)] (if (= d (array/nth mins k)) 1 0)) rd rk)))
         first_hit (int_gather hit (array/index_of (int_gather rk hit) crange))
         best_a (exact (map (fn [(k : int)] (int/div (int/sub (array/nth first_hit k) (array/nth roff k))
                  (array/nth bc (array/nth cps k)))) crange))
         best_b (exact (map (fn [(k : int)] (int/mod (int/sub (array/nth first_hit k) (array/nth roff k))
                  (array/nth bc (array/nth cps k)))) crange))
         ; Reverse b when the next a vertex is closer to the previous than to the next b vertex.
         t_an (exact (map (fn [(k : int)]
                (let* [p (array/nth cps k)]
                  (array/nth vert (int/add (array/nth off (array/nth pa p))
                    (int/mod (int/add (array/nth best_a k) 1) (array/nth ac p)))))) crange))
         t_bn (exact (map (fn [(k : int)]
                (let* [p (array/nth cps k)]
                  (array/nth vert (int/add (array/nth off (array/nth pb p))
                    (int/mod (int/add (array/nth best_b k) 1) (array/nth bc p)))))) crange))
         t_bp (exact (map (fn [(k : int)]
                (let* [p (array/nth cps k)]
                  (array/nth vert (int/add (array/nth off (array/nth pb p))
                    (int/mod (int/add (array/nth best_b k) (int/sub (array/nth bc p) 1)) (array/nth bc p)))))) crange))
         turns (loft_dists g (array/concat t_an t_an) (array/concat t_bp t_bn))
         turn (exact (map (fn [(k : int)] (if (< (array/nth turns k) (array/nth turns (int/add k ncp))) 1 0)) crange))
         crank (array/scan_sum use_closed)
         at (exact (map (fn [(p : int)] (if (int/eq (array/nth use_closed p) 1) (array/nth crank p) ncp)) idx))
         pad_a (array/concat best_a (array/int 1 0))
         pad_b (array/concat best_b (array/int 1 0))
         pad_t (array/concat turn (array/int 1 0))
         a_rev (exact (map (fn [(p : int)]
                 (if (int/eq (array/nth use_closed p) 1) 0
                   (if (and connect (int/ge (array/nth best p) 2)) 1 0))) idx))
         b_rev (exact (map (fn [(p : int)]
                 (if (int/eq (array/nth use_closed p) 1) (array/nth pad_t (array/nth at p))
                   (if (and connect (int/eq (int/mod (array/nth best p) 2) 1)) 1 0))) idx))
         a_shift (exact (map (fn [(p : int)]
                   (if (int/eq (array/nth use_closed p) 1) (array/nth pad_a (array/nth at p))
                     (if (int/eq (array/nth a_rev p) 1) (int/sub (array/nth ac p) 1) 0))) idx))
         b_base (exact (map (fn [(p : int)]
                  (if (int/eq (array/nth use_closed p) 1) (array/nth pad_b (array/nth at p))
                    (if (int/eq (array/nth b_rev p) 1) (int/sub (array/nth bc p) 1) 0))) idx))
         b_shift (exact (map (fn [(p : int)]
                   (let* [bcn (array/nth bc p)
                          sm (int/mod (int/add (int/mod shift bcn) bcn) bcn)]
                     (int/mod (int/add (array/nth b_base p) sm) bcn))) idx))]
    {:a_shift a_shift :a_rev a_rev :b_shift b_shift :b_rev b_rev}))

; ---- zipper (one move of every pair per iteration) and polygon pairing ----
; Returns generated primitives as corner vertex rows c0..c3 (c3 = -1 for triangles) and their pair.
(defn loft_zip :context sop
  [(g : {:x (array float) :y (array float) :z (array float) :p (array int)})
   (off : (array int)) (vert : (array int)) (closed : (array int))
   (pa : (array int)) (pb : (array int))
   (al : {:a_shift (array int) :a_rev (array int) :b_shift (array int) :b_rev (array int)})
   (three : bool) (tol : float) (polygons : bool)]
  (let* [pairs (array/count pa)
         idx (array/range pairs :type int)
         ash al.a_shift arv al.a_rev bsh al.b_shift brv al.b_rev
         ac (exact (map (fn [(p : int)] (int/sub (array/nth off (int/add (array/nth pa p) 1)) (array/nth off (array/nth pa p)))) idx))
         bc (exact (map (fn [(p : int)] (int/sub (array/nth off (int/add (array/nth pb p) 1)) (array/nth off (array/nth pb p)))) idx))
         both (exact (map (fn [(p : int)]
                (int/mul (array/nth closed (array/nth pa p)) (array/nth closed (array/nth pb p)))) idx))
         a_steps (exact (map (fn [(p : int)] (int/sub (array/nth ac p) (int/sub 1 (array/nth both p)))) idx))
         b_steps (exact (map (fn [(p : int)] (int/sub (array/nth bc p) (int/sub 1 (array/nth both p)))) idx))
         quad (exact (map (fn [(p : int)] (if (and polygons (int/eq (array/nth ac p) (array/nth bc p))) 1 0)) idx))
         total (exact (map (fn [(p : int)] (if (int/eq (array/nth quad p) 1) 0 (int/add (array/nth a_steps p) (array/nth b_steps p)))) idx))
         most (if (int/eq pairs 0) 0 (array/max total))
         ; The four sides of every query: a at ai, a at ai+1, b at bi, b at bi+1.
         sec4 (array/concat (array/concat pa pa) (array/concat pb pb))
         sh4 (array/concat (array/concat ash ash) (array/concat bsh bsh))
         rv4 (array/concat (array/concat arv arv) (array/concat brv brv))
         final (iterate most {:ai (array/int pairs 0) :bi (array/int pairs 0) :hist (array/int (int/mul most pairs) 0) :k 0}
           (fn [(c : {:ai (array int) :bi (array int) :hist (array int) :k int})]
             (let* [ai c.ai bi c.bi
                    vs (loft_vertices off vert sec4 sh4 rv4
                         (array/concat (array/concat ai (exact (map (fn [(a : int)] (int/add a 1)) ai)))
                                       (array/concat bi (exact (map (fn [(b : int)] (int/add b 1)) bi)))))
                    av (array/slice vs 0 pairs) an (array/slice vs pairs pairs)
                    bv (array/slice vs (int/mul 2 pairs) pairs) bn (array/slice vs (int/mul 3 pairs) pairs)
                    left (array/concat (array/concat an av) (array/concat av bv))
                    right (array/concat (array/concat bv bn) (array/concat an bn))
                    sc (loft_scales g left right)
                    ln (loft_nlens g left right sc)
                    ds (exact (map (fn [(s : float) (l : float)] (* s l)) sc ln))
                    cmp3 (exact (map (fn [(p : int)]
                           (let* [sa (+ (array/nth ds p) (array/nth ds (int/add p (int/mul 2 pairs))))
                                  sb (+ (array/nth ds (int/add p pairs)) (array/nth ds (int/add p (int/mul 3 pairs))))
                                  fa (if (= (- sa sa) 0.0) sa 1.7976931348623157e308)
                                  fb (if (= (- sb sb) 0.0) sb 1.7976931348623157e308)]
                             (if (<= fa fb) 1 0))) idx))
                    cmp2 (exact (map (fn [(p : int)]
                           (let* [x (array/nth sc p) y (array/nth sc (int/add p pairs))
                                  lx (array/nth ln p) ly (array/nth ln (int/add p pairs))
                                  rx (if (= x 0.0) 1.0 x) ry (if (= y 0.0) 1.0 y)
                                  small (<= (* (/ x ry) lx) ly) large (<= lx (* (/ y rx) ly))]
                             (if (= x 0.0) 1
                               (if (= y 0.0) 0
                                 (if (<= x y) (if small 1 0) (if large 1 0)))))) idx))
                    cmp (exact (map (fn [(a : int) (b : int)] (if three a b)) cmp3 cmp2))
                    code (exact (map (fn [(p : int)]
                           (let* [can_a (int/lt (array/nth ai p) (array/nth a_steps p))
                                  can_b (int/lt (array/nth bi p) (array/nth b_steps p))
                                  active (and (int/eq (array/nth quad p) 0) (or can_a can_b))]
                             (if active
                               (if can_b (if can_a (array/nth cmp p) 0) 1)
                               2))) idx))]
               {:ai (exact (map (fn [(a : int) (k : int)] (if (int/eq k 1) (int/add a 1) a)) ai code))
                :bi (exact (map (fn [(b : int) (k : int)] (if (int/eq k 0) (int/add b 1) b)) bi code))
                :hist (exact (map (fn [(a : int) (b : int)] (int/add a b)) c.hist
                        (array/scatter_add (exact (map (fn [(p : int)] (int/add (int/mul c.k pairs) p)) idx))
                          code (int/mul most pairs))))
                :k (int/add c.k 1)})))
         hist final.hist
         ; ---- triangles from the zipper moves ----
         toff (array/scan_sum total)
         steps (array/nth toff pairs)
         srows (array/range steps :type int)
         tcum (array/scan_sum (array/scatter_add (array/slice toff 0 pairs) (array/int pairs 1) (int/add steps 1)))
         tp (exact (map (fn [(r : int)] (int/sub (array/nth tcum (int/add r 1)) 1)) srows))
         moves (exact (map (fn [(r : int) (p : int)] (array/nth hist (int/add (int/mul (int/sub r (array/nth toff p)) pairs) p))) srows tp))
         msum (array/scan_sum moves)
         zai (exact (map (fn [(r : int) (p : int)] (int/sub (array/nth msum r) (array/nth msum (array/nth toff p)))) srows tp))
         zbi (exact (map (fn [(r : int) (p : int) (a : int)] (int/sub (int/sub r (array/nth toff p)) a)) srows tp zai))
         ra (int_gather pa tp) rb (int_gather pb tp)
         rash (int_gather ash tp) rarv (int_gather arv tp) rbsh (int_gather bsh tp) rbrv (int_gather brv tp)
         zv (loft_vertices off vert
              (array/concat (array/concat ra ra) (array/concat rb rb))
              (array/concat (array/concat rash rash) (array/concat rbsh rbsh))
              (array/concat (array/concat rarv rarv) (array/concat rbrv rbrv))
              (array/concat (array/concat zai (exact (map (fn [(a : int)] (int/add a 1)) zai)))
                            (array/concat zbi (exact (map (fn [(b : int)] (int/add b 1)) zbi)))))
         zav (loft_part zv 0 steps) zan (loft_part zv steps steps)
         zbv (loft_part zv (int/mul 2 steps) steps) zbn (loft_part zv (int/mul 3 steps) steps)
         zc1 (exact (map (fn [(m : int) (u : int) (v : int)] (int/add (int/mul m u) (int/mul (int/sub 1 m) v))) moves zan zbn))
         zgood (exact (map (fn [(u : int) (v : int) (w : int)]
                 (let* [pu (array/nth g.p u) pv (array/nth g.p v) pw (array/nth g.p w)]
                   (if (and (not (int/eq pu pv)) (and (not (int/eq pv pw)) (not (int/eq pw pu)))) 1 0)))
                 zav zc1 zbv))
         znc (loft_ncs g tol zav zc1 zbv)
         zflat (exact (map (fn [(a : int) (b : int)] (if (and (int/eq a 1) (or (= tol 0.0) (int/eq b 1))) 1 0)) zgood znc))
         zkeep (array/compact zflat)
         ; ---- quads of equal-count pairs ----
         qn (exact (map (fn [(p : int)] (if (int/eq (array/nth quad p) 1) (array/nth a_steps p) 0)) idx))
         qoff (array/scan_sum qn)
         qtotal (array/nth qoff pairs)
         qrows (array/range qtotal :type int)
         qcum (array/scan_sum (array/scatter_add (array/slice qoff 0 pairs) (array/int pairs 1) (int/add qtotal 1)))
         qp (exact (map (fn [(r : int)] (int/sub (array/nth qcum (int/add r 1)) 1)) qrows))
         qlocal (exact (map (fn [(r : int) (p : int)] (int/sub r (array/nth qoff p))) qrows qp))
         qa (int_gather pa qp) qb (int_gather pb qp)
         qv (loft_vertices off vert
              (array/concat (array/concat qa qa) (array/concat qb qb))
              (array/concat (array/concat (int_gather ash qp) (int_gather ash qp)) (array/concat (int_gather bsh qp) (int_gather bsh qp)))
              (array/concat (array/concat (int_gather arv qp) (int_gather arv qp)) (array/concat (int_gather brv qp) (int_gather brv qp)))
              (array/concat (array/concat qlocal (exact (map (fn [(l : int)] (int/add l 1)) qlocal)))
                            (array/concat qlocal (exact (map (fn [(l : int)] (int/add l 1)) qlocal)))))
         qav (loft_part qv 0 qtotal) qan (loft_part qv qtotal qtotal)
         qbv (loft_part qv (int/mul 2 qtotal) qtotal) qbn (loft_part qv (int/mul 3 qtotal) qtotal)
         qunique (exact (map (fn [(r : int)]
                   (let* [ap (array/nth g.p (array/nth qav r)) anp (array/nth g.p (array/nth qan r))
                          bp (array/nth g.p (array/nth qbv r)) bnp (array/nth g.p (array/nth qbn r))]
                     (if (int/ge (int/add (int/add (int/add 1 (if (int/eq anp ap) 0 1))
                                    (if (and (not (int/eq bp ap)) (not (int/eq bp anp))) 1 0))
                                  (if (and (not (int/eq bnp ap)) (and (not (int/eq bnp anp)) (not (int/eq bnp bp)))) 1 0)) 3) 1 0)))
                   qrows))
         qfirst (loft_ncs g tol qav qan qbn)
         qsecond (loft_ncs g tol qav qbn qbv)
         qflat (exact (map (fn [(u : int) (a : int) (b : int)]
                 (if (and (int/eq u 1) (or (= tol 0.0) (or (int/eq a 1) (int/eq b 1)))) 1 0))
                 qunique qfirst qsecond))
         qkeep (array/compact qflat)
         tri_count (array/count zkeep)
         all_c0 (array/concat (int_gather zav zkeep) (int_gather qav qkeep))
         all_c1 (array/concat (int_gather zc1 zkeep) (int_gather qan qkeep))
         all_c2 (array/concat (int_gather zbv zkeep) (int_gather qbn qkeep))
         all_c3 (array/concat (array/int tri_count -1) (int_gather qbv qkeep))
         all_pair (array/concat (int_gather tp zkeep) (int_gather qp qkeep))
         order (array/grade all_pair)]
    {:c0 (int_gather all_c0 order) :c1 (int_gather all_c1 order) :c2 (int_gather all_c2 order)
     :c3 (int_gather all_c3 order) :pair (int_gather all_pair order)}))

; ---- the node body shared by PolyLoft (triangles) and Skin (polygons) ----
(defn loft_error :context value [(operation : text) (reason : text)]
  (error "invalid_topology" (str operation " could not produce valid geometry")
    :cause (str operation " [invalid_topology]: " reason)))

; Expand a CSR (offsets over `rows` owners) into per-element owner ids.
(defn loft_owners :context value [(offsets : (array int))]
  (let* [rows (int/sub (array/count offsets) 1)
         total (array/nth offsets rows)
         cumulative (array/scan_sum (array/scatter_add (array/slice offsets 0 rows) (array/int rows 1) (int/add total 1)))]
    (exact (map (fn [(r : int)] (int/sub (array/nth cumulative (int/add r 1)) 1)) (array/range total :type int)))))

(defn loft_run :context sop
  [(in0 : geometry) (guide : geometry) (operation : text) (group_name : text) (connect : bool) (three : bool)
   (u_wrap : bool) (v_wrap : bool) (keep : bool) (output_name : text) (tol : float) (recompute : bool)
   (polygons : bool)]
  (let* [topology (sop/topology in0)
         offsets topology.primitive_offsets kinds topology.kinds tvp topology.vertex_points
         prims (sop/count in0 :primitives)
         points (sop/count in0 :points)
         mask (if (text/blank? group_name) (array/int prims 1) (sop/group in0 :name group_name :owner "primitive"))
         sizes (exact (map (fn [(p : int)] (int/sub (array/nth offsets (int/add p 1)) (array/nth offsets p))) (array/range prims :type int)))
         bad (array/compact (exact (map (fn [(m : int) (k : int) (s : int)]
               (if (int/eq m 1) (if (int/eq k 1) (if (int/lt s 2) 1 0) (if (int/lt s 3) 1 0)) 0)) mask kinds sizes)))]
    (if (int/gt (array/count bad) 0)
      (let* [p (array/nth bad 0)]
        (if (int/eq (array/nth kinds p) 1)
          (loft_error operation (str "selected open curve " p " has fewer than two vertices"))
          (loft_error operation (str "selected closed section " p " has fewer than three vertices"))))
      (let* [sections (array/compact mask)
             sc (array/count sections)]
        (cond
          (int/lt sc 2) in0
          (not (int/eq (sop/count guide :points) points))
            (loft_error operation "rest geometry point count does not match input")
          :else
          (let* [positions (sop/attr guide "P")
                 g {:x (exact (map (fn [(q : vec3)] q.x) positions)) :y (exact (map (fn [(q : vec3)] q.y) positions))
                    :z (exact (map (fn [(q : vec3)] q.z) positions)) :p tvp}
                 sec_off (array/scan_sum (exact (map (fn [(p : int)] (array/nth sizes p)) sections)))
                 owner (loft_owners sec_off)
                 vert (exact (map (fn [(i : int) (s : int)]
                        (int/add (array/nth offsets (array/nth sections s)) (int/sub i (array/nth sec_off s))))
                        (array/range (array/count owner) :type int) owner))
                 closed (exact (map (fn [(p : int)] (if (or u_wrap (not (int/eq (array/nth kinds p) 1))) 1 0)) sections))
                 pair_count (int/add (int/sub sc 1) (if (and v_wrap (int/gt sc 2)) 1 0))
                 pa (array/range pair_count :type int)
                 pb (exact (map (fn [(p : int)] (if (int/lt (int/add p 1) sc) (int/add p 1) 0)) pa))
                 al (loft_align g sec_off vert closed pa pb connect 0)
                 plan (loft_zip g sec_off vert closed pa pb al three tol polygons)
                 generated (array/count plan.c0)]
            (if (and (int/eq generated 0) (and keep (text/blank? output_name))) in0
              (let* [keep_flags (exact (map (fn [(m : int)] (if (or keep (int/eq m 0)) 1 0)) mask))
                     kept (array/compact keep_flags)
                     kept_count (array/count kept)
                     kept_sizes (int_gather sizes kept)
                     kept_off (array/scan_sum kept_sizes)
                     kept_owner (loft_owners kept_off)
                     kept_vertices (exact (map (fn [(i : int) (s : int)]
                       (int/add (array/nth offsets (array/nth kept s)) (int/sub i (array/nth kept_off s))))
                       (array/range (array/count kept_owner) :type int) kept_owner))
                     arity (exact (map (fn [(c : int)] (if (int/lt c 0) 3 4)) plan.c3))
                     gen_off (array/scan_sum arity)
                     gen_owner (loft_owners gen_off)
                     corner_table (array/concat (array/concat plan.c0 plan.c1) (array/concat plan.c2 plan.c3))
                     gen_vertices (exact (map (fn [(i : int) (j : int)]
                       (array/nth corner_table (int/add (int/mul (int/sub i (array/nth gen_off j)) generated) j)))
                       (array/range (array/count gen_owner) :type int) gen_owner))
                     vertex_map (array/concat kept_vertices gen_vertices)
                     sizes_all (array/concat kept_sizes arity)
                     out_offsets (array/scan_sum sizes_all)
                     out_points (int_gather tvp vertex_map)
                     out_kinds (array/concat (int_gather kinds kept) (array/int generated 0))
                     primitive_map (array/concat kept (exact (map (fn [(pair : int)] (array/nth sections (array/nth pa pair))) plan.pair)))
                     target (sop/mesh :points (array/vec3 points) :vertex_points out_points
                              :primitive_offsets out_offsets :kinds out_kinds)
                     source_adjacency (sop/adjacency in0)
                     target_adjacency (sop/adjacency target)
                     remapped (sop/remap in0 target :points (array/range points :type int) :vertices vertex_map
                                :primitives primitive_map :positions "mapped"
                                :edges (edge_ancestry source_adjacency.edge_a source_adjacency.edge_b
                                         target_adjacency.edge_a target_adjacency.edge_b points))
                     total_out (int/add kept_count generated)
                     grouped (if (text/blank? output_name) remapped
                               (sop/with_group remapped
                                 (exact (map (fn [(p : int)] (if (int/ge p kept_count) 1 0)) (array/range total_out :type int)))
                                 :name output_name :owner "primitive"))
                     had_point (sop/has_attr in0 "N" :owner "point")
                     had_vertex (sop/has_attr in0 "N" :owner "vertex")
                     cleared (sop/delete_attr (sop/delete_attr grouped "N" :owner "point") "N" :owner "vertex")]
                (if (and recompute (or had_point had_vertex))
                  (sop/normals cleared :owner (if had_point "Point" "Vertex") :weighting "Face area")
                  cleared)))))))))


; Edge Transport helpers shared by edge_transport and edge_transport_parent (etp_ prefix).
; Native edge_length: coordinates scaled by the largest magnitude of the six, then
; scale * sqrt(dx*dx + dy*dy + dz*dz) with the arm64 contraction (right product fused).
(defn etp_length :context value [(a : vec3) (b : vec3)]
  (let* [scale (max (max (max (abs a.x) (abs b.x)) (max (abs a.y) (abs b.y)))
                    (max (abs a.z) (abs b.z)))
         divisor (if (= scale 0.0) 1.0 scale)
         dx (- (/ b.x divisor) (/ a.x divisor))
         dy (- (/ b.y divisor) (/ a.y divisor))
         dz (- (/ b.z divisor) (/ a.z divisor))]
    (if (= scale 0.0) 0.0 (* scale (sqrt (fma dz dz (fma dy dy (* dx dx))))))))

; operation: 0 Transport, 1 From root, 2 Total, 3 Maximum, 4 Minimum
(defn etp_forward :context value
  [(cfg : {:par (array int) :dep (array int) :rt (array int) :cc (array int) :scale (array float)
           :inp (array float) :op int :hold bool :split bool :fuse bool :passes int})]
  (let* [par cfg.par dep cfg.dep rt cfg.rt cc cfg.cc scale cfg.scale inp cfg.inp
         op cfg.op hold cfg.hold split cfg.split fuse cfg.fuse
         points (array/range (array/count inp) :type int)]
    (iterate cfg.passes inp
      (fn [(state : (array float))]
        (exact (map (fn [(p : int)]
          (let* [d (array/nth dep p)]
            (if (int/lt d 0) (array/nth state p)
              (if (int/eq d 0)
                (cond (int/le op 1) (if hold (array/nth inp p) 0.0)
                      (int/eq op 2) 0.0
                      :else (array/nth inp p))
                (let* [q (array/nth par p)
                       from (array/nth state q)
                       i (array/nth inp p)
                       divisor (float (array/nth cc q))]
                  (cond
                    (int/eq op 0) (if split (/ from divisor) from)
                    (int/eq op 1) (array/nth state (array/nth rt p))
                    (int/eq op 2) (let* [v (if fuse (fma (array/nth inp q) (array/nth scale p) from)
                                             (+ from (* (array/nth inp q) (array/nth scale p))))]
                                    (if split (/ v divisor) v))
                    (int/eq op 3) (if (> i from) i from)
                    :else (if (< i from) i from)))))))
          points))))))

; merge: 0 Add, 1 Maximum, 2 Minimum. A child candidate is its value, or for Total
; value + input * edge scale (fused).
(defn etp_backward :context value
  [(cfg : {:off (array int) :kids (array int) :dep (array int) :scale (array float) :inp (array float)
           :op int :merge int :hold bool :fuse bool :passes int})]
  (let* [off cfg.off kids cfg.kids dep cfg.dep scale cfg.scale inp cfg.inp
         op cfg.op merge cfg.merge hold cfg.hold fuse cfg.fuse
         points (array/range (array/count inp) :type int)
         slots (array/range (array/count kids) :type int)]
    (iterate cfg.passes inp
      (fn [(state : (array float))]
        (let* [cand (exact (map (fn [(k : int)]
                      (let* [c (array/nth kids k)]
                        (if (int/eq op 2)
                          (if fuse (fma (array/nth inp c) (array/nth scale c) (array/nth state c))
                            (+ (array/nth state c) (* (array/nth inp c) (array/nth scale c))))
                          (array/nth state c)))) slots))
               best (cond
                      (int/eq merge 0) (array/segment_sum cand off)
                      (int/eq merge 1)
                        (let* [at (array/segment_argmax cand off)]
                          (exact (map (fn [(a : int)] (if (int/lt a 0) 0.0 (array/nth cand a))) at)))
                      :else
                        (let* [at (array/segment_argmax (exact (map (fn [(x : float)] (- 0.0 x)) cand)) off)]
                          (exact (map (fn [(a : int)] (if (int/lt a 0) 0.0 (array/nth cand a))) at))))]
          (exact (map (fn [(p : int)]
            (if (int/lt (array/nth dep p) 0) (array/nth state p)
              (let* [first (array/nth off p)
                     leaf (int/eq first (array/nth off (int/add p 1)))
                     i (array/nth inp p)
                     b (array/nth best p)]
                (if leaf
                  (cond (int/le op 1) (if hold i 0.0)
                        (int/eq op 2) 0.0
                        :else i)
                  (cond (int/eq op 3) (if (> i b) i b)
                        (int/eq op 4) (if (< i b) i b)
                        :else b)))))
            points)))))))

; mode: 0 None, 1 Per group, 2 Global. `members` lists the tree points and `keys` gives every point a
; group key (its tree's root, or its connected component); only members are rewritten.
(defn etp_normalize :context value
  [(field : (array float)) (members : (array int)) (keys : (array int)) (mode : int)]
  (if (or (int/eq mode 0) (int/eq (array/count members) 0)) field
    (let* [count (array/count members)
           ranks (array/range count :type int)
           grade (array/grade (exact (map (fn [(p : int)] (array/nth keys p)) members)))
           sorted (exact (map (fn [(k : int)] (array/nth members (array/nth grade k))) ranks))
           sorted_keys (exact (map (fn [(p : int)] (array/nth keys p)) sorted))
           sorted_values (exact (map (fn [(p : int)] (array/nth field p)) sorted))
           flags (exact (map (fn [(k : int)]
                   (if (int/eq k 0) 1
                     (if (int/eq (array/nth sorted_keys k) (array/nth sorted_keys (int/sub k 1))) 0 1))) ranks))
           offsets (array/concat (array/compact flags) (array/int 1 count))
           lows (array/segment_min sorted_values offsets)
           highs (array/segment_max sorted_values offsets)
           ids (array/slice (array/scan_sum flags) 1 count)
           low_all (array/min sorted_values)
           high_all (array/max sorted_values)
           normal (exact (map (fn [(v : float) (id : int)]
                    (let* [low (if (int/eq mode 2) low_all (array/nth lows (int/sub id 1)))
                           high (if (int/eq mode 2) high_all (array/nth highs (int/sub id 1)))
                           span (- high low)]
                      (if (= span 0.0) 0.0 (/ (- v low) span)))) sorted_values ids))
           scattered (array/scatter_add sorted normal (array/count field))
           member_mask (array/scatter_add members (array/int count 1) (array/count field))]
      (exact (map (fn [(p : int) (v : float)] (if (int/eq (array/nth member_mask p) 0) v (array/nth scattered p)))
        (array/range (array/count field) :type int) field)))))

)
