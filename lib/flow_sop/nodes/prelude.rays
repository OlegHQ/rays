; Shared value helpers. Matrices are row-major records and multiply column vectors.
(workspace sop_nodes
  (defmacro setter_constant [geo owner name type constructor value]
    `(if (equal? ~owner "Point")
       (sop/with_attr ~geo ~name (~constructor (sop/count ~geo :points) ~value) :owner "point" :type ~type)
       (if (equal? ~owner "Vertex")
         (sop/with_attr ~geo ~name (~constructor (sop/count ~geo :vertices) ~value) :owner "vertex" :type ~type)
         (if (equal? ~owner "Primitive")
           (sop/with_attr ~geo ~name (~constructor (sop/count ~geo :primitives) ~value) :owner "primitive" :type ~type)
           (sop/with_attr ~geo ~name (~constructor 1 ~value) :owner "detail" :type ~type)))))

  ; Integer floor/ceil keep their existing contract. Guard the eager conversion
  ; branch and preserve signed zero, including ceil of a small negative value.
  (defn float_floor :context value [(value : float)]
    (let* [large (>= (abs value) 4503599627370496.0)
           rounded (float (floor (if large 0.0 value)))]
      (if (or large (= value 0.0)) value rounded)))
  (defn float_ceil :context value [(value : float)]
    (let* [large (>= (abs value) 4503599627370496.0)
           rounded (float (ceil (if large 0.0 value)))]
      (if (or large (= value 0.0)) value
        (if (and (< value 0.0) (= rounded 0.0)) -0.0 rounded))))

  (defn vec3_dot :context value [(left : vec3) (right : vec3)]
    (+ (+ (* left.x right.x) (* left.y right.y)) (* left.z right.z)))
  (defn vec3_cross :context value [(left : vec3) (right : vec3)]
    ; Native FMSUB subtracts the second product from the rounded first product.
    [(fma (* -1.0 left.z) right.y (* left.y right.z))
     (fma (* -1.0 left.x) right.z (* left.z right.x))
     (fma (* -1.0 left.y) right.x (* left.x right.y))])
  ; Vec3.normalize uses a zero-only test and reciprocal multiplication.
  (defn vec3_normalize :context value [(value : vec3)]
    (let* [size (sqrt (vec3_dot value value))
           reciprocal (/ 1.0 (if (= size 0.0) 1.0 size))]
      (if (= size 0.0) [0.0 0.0 0.0] (* value reciprocal))))
  ; Deform's frame construction rescales before taking the length, then divides.
  (defn vec3_normalize_scaled :context value [(value : vec3)]
    (let* [scale (max (abs value.x) (max (abs value.y) (abs value.z)))
           scaled (/ value (if (= scale 0.0) 1.0 scale))
           size (sqrt (vec3_dot scaled scaled))]
      (if (= scale 0.0) [0.0 0.0 0.0]
        (/ scaled (if (= size 0.0) 1.0 size)))))
  ; Native overflow produces an infinite norm and signed zero components.
  ; Preserve Quat.normalize's left-associated sum, 1e-12 threshold and division.
  (defn quat_normalize :context value [(value : vec4)]
    (let* [product_overflow (> (max (max (abs value.x) (abs value.y))
                                  (max (abs value.z) (abs value.w))) 1.3407807929942596e154)
           safe (if product_overflow [0.0 0.0 0.0 0.0] value)
           xx (* safe.x safe.x) yy (* safe.y safe.y)
           zz (* safe.z safe.z) ww (* safe.w safe.w)
           ; Quarter-sized squares keep even the largest four-term sum finite.
           ; Power-of-two scaling preserves overflow-threshold rounding.
           quarter_total (+ (+ (+ (* xx 0.25) (* yy 0.25)) (* zz 0.25)) (* ww 0.25))
           overflow (or product_overflow (>= quarter_total 4.49423283715579e307))
           factor (if overflow 0.0 1.0)
           ; Rescaling the square root is exact above the identity threshold.
           size (* (sqrt quarter_total) 2.0)
           scaled (* value factor)
           small (and (not overflow) (<= size 1e-12))
           numerator (if small [0.0 0.0 0.0 1.0] scaled)]
      (/ numerator (if (<= size 1e-12) 1.0 size))))
  (defn quat_mul :context value [(left : vec4) (right : vec4)]
    [(- (+ (+ (* left.w right.x) (* left.x right.w)) (* left.y right.z)) (* left.z right.y))
     (+ (+ (- (* left.w right.y) (* left.x right.z)) (* left.y right.w)) (* left.z right.x))
     (+ (- (+ (* left.w right.z) (* left.x right.y)) (* left.y right.x)) (* left.z right.w))
     (- (- (- (* left.w right.w) (* left.x right.x)) (* left.y right.y)) (* left.z right.z))])

  (defn mat4_identity :context value []
    {:r0 [1.0 0.0 0.0 0.0] :r1 [0.0 1.0 0.0 0.0]
     :r2 [0.0 0.0 1.0 0.0] :r3 [0.0 0.0 0.0 1.0]})
  (defn mat4_translation :context value [(value : vec3)]
    {:r0 [1.0 0.0 0.0 value.x] :r1 [0.0 1.0 0.0 value.y]
     :r2 [0.0 0.0 1.0 value.z] :r3 [0.0 0.0 0.0 1.0]})
  (defn mat4_scaling :context value [(value : vec3)]
    {:r0 [value.x 0.0 0.0 0.0] :r1 [0.0 value.y 0.0 0.0]
     :r2 [0.0 0.0 value.z 0.0] :r3 [0.0 0.0 0.0 1.0]})
  (defn mat4_rotation_x :context value [(angle : float)]
    (let* [c (cos angle) s (sin angle)]
      {:r0 [1.0 0.0 0.0 0.0] :r1 [0.0 c (* -1.0 s) 0.0]
       :r2 [0.0 s c 0.0] :r3 [0.0 0.0 0.0 1.0]}))
  (defn mat4_rotation_y :context value [(angle : float)]
    (let* [c (cos angle) s (sin angle)]
      {:r0 [c 0.0 s 0.0] :r1 [0.0 1.0 0.0 0.0]
       :r2 [(* -1.0 s) 0.0 c 0.0] :r3 [0.0 0.0 0.0 1.0]}))
  (defn mat4_rotation_z :context value [(angle : float)]
    (let* [c (cos angle) s (sin angle)]
      {:r0 [c (* -1.0 s) 0.0 0.0] :r1 [s c 0.0 0.0]
       :r2 [0.0 0.0 1.0 0.0] :r3 [0.0 0.0 0.0 1.0]}))
  (defn mat4_rotation :context value [(direction : vec3) (angle : float)]
    (let* [axis (vec3_normalize direction) c (cos angle) s (sin angle) d (- 1.0 c)]
      (if (= (vec3_dot axis axis) 0.0) (mat4_identity)
        {:r0 [(+ c (* (* axis.x axis.x) d))
              (- (* (* axis.x axis.y) d) (* axis.z s))
              (+ (* (* axis.x axis.z) d) (* axis.y s)) 0.0]
         :r1 [(+ (* (* axis.y axis.x) d) (* axis.z s))
              (+ c (* (* axis.y axis.y) d))
              (- (* (* axis.y axis.z) d) (* axis.x s)) 0.0]
         :r2 [(- (* (* axis.z axis.x) d) (* axis.y s))
              (+ (* (* axis.z axis.y) d) (* axis.x s))
              (+ c (* (* axis.z axis.z) d)) 0.0]
         :r3 [0.0 0.0 0.0 1.0]})))
  (defn mat4_transpose :context value [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    {:r0 [matrix.r0.x matrix.r1.x matrix.r2.x matrix.r3.x]
     :r1 [matrix.r0.y matrix.r1.y matrix.r2.y matrix.r3.y]
     :r2 [matrix.r0.z matrix.r1.z matrix.r2.z matrix.r3.z]
     :r3 [matrix.r0.w matrix.r1.w matrix.r2.w matrix.r3.w]})
  ; Mat4.mul starts each accumulator at positive zero, unlike a dot product.
  (defn mat4_mul_row :context value [(row : vec4) (right : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    [(fma row.w right.r3.x (fma row.z right.r2.x
       (fma row.y right.r1.x (fma row.x right.r0.x 0.0))))
     (fma row.w right.r3.y (fma row.z right.r2.y
       (fma row.y right.r1.y (fma row.x right.r0.y 0.0))))
     (fma row.w right.r3.z (fma row.z right.r2.z
       (fma row.y right.r1.z (fma row.x right.r0.z 0.0))))
     (fma row.w right.r3.w (fma row.z right.r2.w
       (fma row.y right.r1.w (fma row.x right.r0.w 0.0))))])
  (defn mat4_mul :context value
    [(left : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})
     (right : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    {:r0 (mat4_mul_row left.r0 right) :r1 (mat4_mul_row left.r1 right)
     :r2 (mat4_mul_row left.r2 right) :r3 (mat4_mul_row left.r3 right)})
  (defn mat4_dot4 :context value [(row : vec4) (value : vec4)]
    (+ (+ (+ (* row.x value.x) (* row.y value.y)) (* row.z value.z)) (* row.w value.w)))
  (defn mat4_transform :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (value : vec4)]
    [(mat4_dot4 matrix.r0 value) (mat4_dot4 matrix.r1 value)
     (mat4_dot4 matrix.r2 value) (mat4_dot4 matrix.r3 value)])
  (defn mat4_point_row :context value [(row : vec4) (value : vec3)]
    (+ (+ (+ (* row.x value.x) (* row.y value.y)) (* row.z value.z)) row.w))
  (defn mat4_transform_point :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (value : vec3)]
    (let* [result [(mat4_point_row matrix.r0 value) (mat4_point_row matrix.r1 value)
                  (mat4_point_row matrix.r2 value)]
           w (mat4_point_row matrix.r3 value) raw (<= (abs w) 1e-12)]
      (if raw result (/ result (if raw 1.0 w)))))
  (defn mat4_direction_row :context value [(row : vec4) (value : vec3)]
    (+ (+ (* row.x value.x) (* row.y value.y)) (* row.z value.z)))
  (defn mat4_transform_direction :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (value : vec3)]
    [(mat4_direction_row matrix.r0 value) (mat4_direction_row matrix.r1 value)
     (mat4_direction_row matrix.r2 value)])

  (defn vec4_component :context value [(value : vec4) (index : int)]
    (case index 0 value.x 1 value.y 2 value.z :else value.w))
  ; Partial-pivot Gauss-Jordan, matching Mat4.inverse's first-tie pivot rule.
  ; Empty list denotes singular; a successful inverse is the single list item.
  (defn mat4_inverse :context value [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    (let* [initial (list {:left matrix.r0 :right [1.0 0.0 0.0 0.0]}
                        {:left matrix.r1 :right [0.0 1.0 0.0 0.0]}
                        {:left matrix.r2 :right [0.0 0.0 1.0 0.0]}
                        {:left matrix.r3 :right [0.0 0.0 0.0 1.0]})
           reduced (fold [state {:rows initial :singular false}] [column (range 4)]
             (let* [pivot (fold [best column] [candidate (range (+ column 1) 4)]
                      (if (> (abs (vec4_component (get (nth state.rows candidate) :left) column))
                             (abs (vec4_component (get (nth state.rows best) :left) column)))
                        candidate best))
                    pivot_row (nth state.rows pivot)
                    divisor (vec4_component pivot_row.left column)]
               (if (<= (abs divisor) 1e-12) (assoc state :singular true)
                 (let* [normalized {:left (/ pivot_row.left divisor) :right (/ pivot_row.right divisor)}
                        swapped (for [index (range 4)]
                          (if (= index column) normalized
                            (if (= index pivot) (nth state.rows column) (nth state.rows index))))
                        eliminated (for [row (range 4)]
                          (let* [entry (nth swapped row) factor (vec4_component entry.left column)]
                            (if (= row column) entry
                              {:left (- entry.left (* factor normalized.left))
                               :right (- entry.right (* factor normalized.right))})))]
                   (assoc state :rows eliminated)))))]
      (if reduced.singular (list)
        (list {:r0 (get (nth reduced.rows 0) :right) :r1 (get (nth reduced.rows 1) :right)
               :r2 (get (nth reduced.rows 2) :right) :r3 (get (nth reduced.rows 3) :right)}))))

  (defn rand_mix_index :context value [(value : int)]
    (let* [a (int/xor value (int/shr value 30))
           b (int/mul a 4564476756301768121)
           c (int/xor b (int/shr b 27))
           d (int/mul c 1499779743744070123)]
      (int/xor d (int/shr d 31))))
  (defn rand_at :context value [(seed : int) (index : int)]
    (let* [key (int/xor seed (int/mul (int/add index 1276007651554290947)
                                     2177342782468422677))]
      (/ (float (int/shr (rand_mix_index key) 10)) 9007199254740992.0)))

  ; Reindexing helpers (C.8). Exact integer gather: source[index[i]].
  (defn int_gather :context value [(source : (array int)) (index : (array int))]
    (exact (map (fn [(at : int)] (array/nth source at)) index)))
  ; Owning primitive of every vertex, from the primitive start offsets (without the terminal).
  (defn prim_of_vertex :context value [(starts : (array int)) (vertices : int)]
    (exact (map (fn [(seen : int)] (int/sub seen 1))
      (array/slice (array/scan_sum (array/scatter_add starts (array/int (array/count starts) 1)
                                    (int/add vertices 1))) 1 vertices))))
  ; Edge ancestry CSR for sop/remap. Unique edges are given by endpoints in one point
  ; space (target endpoints already translated to source points, -1 when a point is gone);
  ; a target edge's row holds the source edge with the same endpoints, or is empty.
  (defn edge_ancestry :context value [(source_a : (array int)) (source_b : (array int))
                                      (target_a : (array int)) (target_b : (array int)) (points : int)]
    (let* [found (exact (array/index_of
             (map (fn [(a : int) (b : int)] (int/add (int/mul (min a b) points) (max a b))) source_a source_b)
             (map (fn [(a : int) (b : int)]
                    (if (or (int/lt a 0) (int/lt b 0)) -1 (int/add (int/mul (min a b) points) (max a b))))
               target_a target_b)))
           present (exact (map (fn [(edge : int)] (if (int/ge edge 0) 1 0)) found))]
      {:offsets (array/scan_sum present)
       :values (int_gather found (array/compact present))}))

  ; Group values are {:mask :ordered :indices}; combining follows Group.combine's order algebra
  ; (union/xor: left preference then right; intersection: the ordered operand; subtract: the left).
  (defn group_value_keep :context value [(indices : (array int)) (keep : (array int))]
    (let* [positions (array/compact (map (fn [(i : int)] (array/nth keep i)) indices))]
      (exact (map (fn [(p : int)] (array/nth indices p)) positions))))
  (defn group_value_preferred :context value
    [(g : {:mask (array int) :ordered bool :indices (array int)})]
    (if g.ordered g.indices (array/compact g.mask)))
  (defn group_value_apply :context value
    [(operation : text) (l : {:mask (array int) :ordered bool :indices (array int)})
     (r : {:mask (array int) :ordered bool :indices (array int)})]
    (if (equal? operation "replace") r
      (let* [mask (exact (case operation
                    "union" (map (fn [(a : int) (b : int)] (int/or a b)) l.mask r.mask)
                    "intersection" (map (fn [(a : int) (b : int)] (int/and a b)) l.mask r.mask)
                    "subtract" (map (fn [(a : int) (b : int)] (int/and a (int/sub 1 b))) l.mask r.mask)
                    :else (map (fn [(a : int) (b : int)] (int/xor a b)) l.mask r.mask)))]
        (cond
          (equal? operation "subtract")
            (if l.ordered {:mask mask :ordered true :indices (group_value_keep l.indices mask)}
              {:mask mask :ordered false :indices (array/int 0)})
          (equal? operation "intersection")
            (if (or l.ordered r.ordered)
              {:mask mask :ordered true
               :indices (group_value_keep (group_value_preferred (if l.ordered l r)) mask)}
              {:mask mask :ordered false :indices (array/int 0)})
          :else
            (if (or l.ordered r.ordered)
              {:mask mask :ordered true
               :indices (array/concat (group_value_keep (group_value_preferred l) mask)
                 (group_value_keep (group_value_preferred r)
                   (map (fn [(m : int) (lm : int)] (int/and m (int/sub 1 lm))) mask l.mask)))}
              {:mask mask :ordered false :indices (array/int 0)})))))
  ; Publish a generated mask under a name, merging with an existing group of that
  ; owner and name (publish_merged_selection). A missing group takes the mask, or an
  ; empty one for intersection and subtract.
  (defn group_exists :context sop [(geo : geometry) (owner : text) (name : text)]
    (fold [found false] [probe (array/text 1 name)]
      (int/gt (array/count (sop/group_names geo (text/glob_literal probe) :owner owner)) 0)))
  (defn group_publish :context sop
    [(geo : geometry) (owner : text) (name : text) (merge : text) (generated : (array int))]
    (let* [mine {:mask generated :ordered false :indices (array/int 0)}
           existing (group_exists geo owner name)
           current (if existing
                     (let* [order (sop/group_order geo :name name :owner owner)]
                       {:mask (sop/group geo :name name :owner owner)
                        :ordered order.ordered :indices order.indices})
                     mine)
           result (if existing (group_value_apply merge current mine)
                    (if (or (equal? merge "intersection") (equal? merge "subtract"))
                      {:mask (exact (map (fn [(a : int)] 0) generated)) :ordered false :indices (array/int 0)}
                      mine))]
      (if (equal? owner "edge")
        (sop/with_group geo (exact result.mask) :name name :owner owner)
        (sop/with_group geo (exact result.mask) :name name :owner owner
          :order {:ordered result.ordered :indices (exact result.indices)}))))

  ; Group.boolean publication used by the group nodes (Group_ops.publish_merged_selection).
  ; Ordered existing groups keep Group.combine's order rules; an absent group takes the
  ; generated mask for Replace/Union/Exclusive or and the empty group otherwise.
  (defn group_order_filter :context sop [(sequence : (array int)) (mask : (array int))]
    (let* [keep (exact (map (fn [(i : int)] (array/nth mask i)) sequence))]
      (exact (map (fn [(k : int)] (array/nth sequence k)) (array/compact keep)))))
  (defn group_merge_publish_ordered :context sop
    [(geo : geometry) (owner : text) (name : text) (generated : (array int)) (merge : text)
     (generated_ordered : bool) (generated_order : (array int))]
    (let* [exists (fold [found false] [candidate (sop/group_names geo "*" :owner owner)]
                    (or found (equal? candidate name)))]
      (if (not exists)
        (if (or (equal? merge "Intersection") (equal? merge "Subtract"))
          (sop/with_group geo (exact (map (fn [(g : int)] (int/mul g 0)) generated)) :name name :owner owner)
          (if generated_ordered
            (sop/with_group geo generated :name name :owner owner :order generated_order)
            (sop/with_group geo generated :name name :owner owner)))
        (let* [old (sop/group geo :name name :owner owner)
               combined (exact (case merge
                 "Union" (map (fn [(o : int) (g : int)] (int/or o g)) old generated)
                 "Intersection" (map (fn [(o : int) (g : int)] (int/and o g)) old generated)
                 "Subtract" (map (fn [(o : int) (g : int)] (int/and o (int/sub 1 g))) old generated)
                 "Exclusive or" (map (fn [(o : int) (g : int)] (int/xor o g)) old generated)
                 :else generated))
               ordering (sop/group_order geo :name name :owner owner)
               lseq (if ordering.ordered ordering.indices (array/compact old))
               rseq (if generated_ordered generated_order (array/compact generated))
               fresh (exact (map (fn [(r : int) (o : int)] (int/and r (int/sub 1 o))) combined old))]
          (cond
            (equal? merge "Replace")
              (if generated_ordered
                (sop/with_group geo combined :name name :owner owner :order generated_order)
                (sop/with_group geo combined :name name :owner owner))
            (or (equal? owner "edge") (not (or ordering.ordered generated_ordered)))
              (sop/with_group geo combined :name name :owner owner)
            (or (equal? merge "Union") (equal? merge "Exclusive or"))
              (sop/with_group geo combined :name name :owner owner
                :order (array/concat (group_order_filter lseq combined) (group_order_filter rseq fresh)))
            (equal? merge "Intersection")
              (sop/with_group geo combined :name name :owner owner
                :order (group_order_filter (if ordering.ordered lseq rseq) combined))
            ordering.ordered
              (sop/with_group geo combined :name name :owner owner :order (group_order_filter lseq combined))
            :else (sop/with_group geo combined :name name :owner owner))))))
  (defn group_merge_publish :context sop
    [(geo : geometry) (owner : text) (name : text) (generated : (array int)) (merge : text)]
    (group_merge_publish_ordered geo owner name generated merge false (array/int 0 0)))

  ; Edge multiplicity: how many corners use each unique edge (Topology_index.edge_offsets).
  (defn edge_usage :context sop [(adjacency : {:edge_of_vertex (array int)}) (edge_count : int)]
    (let* [used (array/compact (exact (map (fn [(e : int)] (if (int/ge e 0) 1 0)) adjacency.edge_of_vertex)))
           edges (exact (map (fn [(v : int)] (array/nth adjacency.edge_of_vertex v)) used))]
      (array/scatter_add edges (array/int (array/count edges) 1) edge_count)))

  ; Transform_ops.transform: positions through the matrix (w divide above 1e-12), then every
  ; vec3 point and vertex N through the inverse transpose, renormalised; a singular matrix drops N.
  (defn transform_normals :context sop
    [(geo : geometry) (owner : text) (normal_matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    (if (sop/has_attr geo "N" :owner owner :type vec3)
      (sop/with_attr geo "N"
        (exact (map (fn [(n : vec3)]
          (let* [o (mat4_transform_direction normal_matrix n)
                 length (sqrt (vec3_dot o o))]
            (if (> length 1e-20) (/ o length) [0.0 0.0 0.0])))
          (sop/attr geo "N" :owner owner :type vec3)))
        :owner owner :type vec3)
      geo))
  ; The native per-point loop m0*x + m1*y + m2*z + m3 fuses the second and third products.
  (defn transform_row_fused :context value [(row : vec4) (p : vec3)]
    (+ (fma row.z p.z (fma row.y p.y (* row.x p.x))) row.w))
  (defn transform_point_fused :context value
    [(matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (p : vec3)]
    (let* [result [(transform_row_fused matrix.r0 p) (transform_row_fused matrix.r1 p)
                   (transform_row_fused matrix.r2 p)]
           w (transform_row_fused matrix.r3 p)
           raw (<= (abs w) 1e-12)]
      (if raw result (/ result (if raw 1.0 w)))))
  (defn transform_geometry :context sop
    [(geo : geometry) (matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
    (let* [moved (sop/with_attr geo :P
                   (exact (map (fn [(p : vec3)] (transform_point_fused matrix p)) (sop/attr geo :P))))
           inverse (mat4_inverse matrix)]
      (if (= (count inverse) 0)
        (sop/delete_attr (sop/delete_attr moved "N" :owner "point") "N" :owner "vertex")
        (transform_normals
          (transform_normals moved "point" (mat4_transpose (nth inverse 0)))
          "vertex" (mat4_transpose (nth inverse 0))))))

  ; Native Vec3.dot (a.x*b.x + a.y*b.y + a.z*b.z) fuses the second and third products on arm64.
  (defn fused_dot :context value [(a : vec3) (b : vec3)]
    (fma a.z b.z (fma a.y b.y (* a.x b.x))))
  (defn fused_normalize :context value [(a : vec3)]
    (let* [size (sqrt (fused_dot a a))]
      (if (= size 0.0) [0.0 0.0 0.0] (* a (/ 1.0 size)))))
  ; Deform.normalize3: rescale by the largest magnitude, then divide by the length.
  ; A zero input gives the zero vector (native None).
  (defn fused_normalize_scaled :context value [(a : vec3)]
    (let* [scale (max (abs a.x) (max (abs a.y) (abs a.z)))
           scaled (/ a (if (= scale 0.0) 1.0 scale))
           size (sqrt (fused_dot scaled scaled))]
      (if (= scale 0.0) [0.0 0.0 0.0] (/ scaled size))))
  ; The point mask of a deformer's group parameter: every point when blank, else the group
  ; promoted to points (any incident member). owner is lowercase point/vertex/primitive/edge.
  (defn deform_mask :context sop [(geo : geometry) (owner : text) (name : text)]
    (if (text/blank? name) (array/int (sop/count geo :points) 1)
      (if (equal? owner "point") (sop/group geo :name name :owner "point")
        (sop/group geo :name name :owner owner :as_owner "point"))))
  (defn deform_group_missing :context sop [(geo : geometry) (owner : text) (name : text)]
    (and (not (text/blank? name))
         (not (fold [found false] [probe (sop/group_names geo "" :owner owner)]
                (or found (equal? probe name))))))
  (defn deform_error :context value [(op : text) (code : text) (reason : text)]
    (error code (str op " could not produce valid geometry")
      :cause (str op " [" code "]: " reason)))

  ; Blast core shared by blast and blast_by_attribute: delete the elements of owner whose
  ; mask entry is 1 (selected) or 0, carrying survivors through sop/remap.
  (defn blast_apply :context sop
    [(in0 : geometry) (owner : text) (kind : text) (mask : (array int)) (selected : bool)
     (compact_points : bool) (policy : text)]
      (let* [points (sop/count in0 :points)
             vertices (sop/count in0 :vertices)
             prims (sop/count in0 :primitives)
             topo (sop/topology in0)
             ; 1 where the element is deleted
             gone_owner (exact (map (fn [(member : int)] (if selected member (int/sub 1 member))) mask))
             by_point (equal? owner "Points")
             by_vertex (equal? owner "Vertices")
             by_primitive (equal? owner "Primitives")
             gone_vertex (cond by_point (int_gather gone_owner topo.vertex_points)
                                by_vertex gone_owner
                                :else (array/int vertices 0))
             gone_sum (array/segment_sum gone_vertex topo.primitive_offsets)
             starts (array/slice topo.primitive_offsets 0 prims)
             ends (array/slice topo.primitive_offsets 1 prims)
             full (exact (map (fn [(first : int) (last : int)] (int/sub last first)) starts ends))
             ; a deleted primitive counts as touched and is always destroyed
             touched_count (if by_primitive gone_owner gone_sum)
             destroy (or by_primitive (equal? policy "Destroy touched primitives"))
             retained_count (exact (map (fn [(size : int) (touched : int) (type : int)]
               (if destroy (if (int/gt touched 0) 0 size)
                 (let* [kept (int/sub size touched)]
                   (if (int/lt kept (if (int/eq type 1) 2 3)) 0 kept))))
               full touched_count topo.kinds))
             prim_map (array/compact (exact (map (fn [(count : int)] (if (int/gt count 0) 1 0)) retained_count)))
             healed (int/gt (array/sum (exact (map (fn [(count : int) (first : int) (last : int)]
                      (if (and (int/gt count 0) (not (int/eq count (int/sub last first)))) 1 0))
                      retained_count starts ends))) 0)
             prim_of_vertex (exact (map (fn [(seen : int)] (int/sub seen 1))
               (array/slice (array/scan_sum (array/scatter_add starts (array/int prims 1) (int/add vertices 1))) 1 vertices)))
             kept_vertex (exact (map (fn [(prim : int) (gone : int)]
               (if (and (int/gt (array/nth retained_count prim) 0) (int/eq gone 0)) 1 0))
               prim_of_vertex gone_vertex))
             vertex_map (array/compact kept_vertex)
             source_points (int_gather topo.vertex_points vertex_map)
             used (exact (map (fn [(uses : int)] (if (int/gt uses 0) 1 0))
                    (array/scatter_add source_points (array/int (array/count source_points) 1) points)))
             gone_point (if by_point gone_owner (array/int points 0))
             keep_point (exact (map (fn [(gone : int) (use : int)]
               (if (and (int/eq gone 0) (or (not compact_points) (int/eq use 1))) 1 0))
               gone_point used))
             point_map (array/compact keep_point)
             retained_points (array/count point_map)]
        (if (and (int/eq retained_points points)
                 (and (int/eq (array/count vertex_map) vertices) (int/eq (array/count prim_map) prims)))
          in0
          (let* [old_to_new (array/scan_sum keep_point)
                 vertex_points (int_gather old_to_new source_points)
                 target (sop/mesh :points (array/vec3 retained_points) :vertex_points vertex_points
                          :primitive_offsets (array/scan_sum (int_gather retained_count prim_map))
                          :kinds (int_gather topo.kinds prim_map))
                 source_edges (sop/edges in0)
                 target_edges (sop/edges target)
                 remapped (sop/remap in0 target
                   :points point_map :vertices vertex_map :primitives prim_map
                   :positions "mapped"
                   :edges (edge_ancestry source_edges.a source_edges.b
                            (int_gather point_map target_edges.a) (int_gather point_map target_edges.b)
                            points))]
            (if healed
              (sop/delete_attr (sop/delete_attr remapped "N" :owner "point") "N" :owner "vertex")
              remapped)))))

  ; Axis frame of the pole-oriented generators (platonic, tube, torus): radial, pole and tangent,
  ; rotated by the rotation order (Plane_generators.normalize_plane_axis rescales before the length).
  (defn gen_normalize :context value [(value : vec3)]
    (let* [scale (max (abs value.x) (max (abs value.y) (abs value.z)))
           x (/ value.x scale) y (/ value.y scale) z (/ value.z scale)
           length (sqrt (fma z z (fma y y (* x x))))]
      [(/ x length) (/ y length) (/ z length)]))
  (defn gen_custom_frame :context value [(axis : vec3)]
    (let* [pole (gen_normalize axis)
           ax (abs pole.x) ay (abs pole.y) az (abs pole.z)
           reference (cond (and (<= ax ay) (<= ax az)) [1.0 0.0 0.0] (<= ay az) [0.0 1.0 0.0] :else [0.0 0.0 1.0])
           projection (fma reference.z pole.z (fma reference.y pole.y (* reference.x pole.x)))
           radial (gen_normalize [(fma (* -1.0 projection) pole.x reference.x)
                                  (fma (* -1.0 projection) pole.y reference.y)
                                  (fma (* -1.0 projection) pole.z reference.z)])]
      {:r radial :p pole :t (gen_normalize (vec3_cross radial pole))}))
  (defn gen_frame :context value [(orientation : text) (axis : vec3) (rotation : vec3) (order : text)]
    (let* [
           frame0 (cond (equal? orientation "X axis") {:r [0.0 1.0 0.0] :p [1.0 0.0 0.0] :t [0.0 0.0 -1.0]}
                        (equal? orientation "Y axis") {:r [1.0 0.0 0.0] :p [0.0 1.0 0.0] :t [0.0 0.0 1.0]}
                        (equal? orientation "Z axis") {:r [1.0 0.0 0.0] :p [0.0 0.0 1.0] :t [0.0 -1.0 0.0]}
                        :else (gen_custom_frame axis))
           rotation_zero (and (= rotation.x 0.0) (and (= rotation.y 0.0) (= rotation.z 0.0)))
           mx (mat4_rotation_x rotation.x) my (mat4_rotation_y rotation.y) mz (mat4_rotation_z rotation.z)
           matrix (case order
             "XYZ" (mat4_mul mz (mat4_mul my mx))
             "XZY" (mat4_mul my (mat4_mul mz mx))
             "YXZ" (mat4_mul mz (mat4_mul mx my))
             "YZX" (mat4_mul mx (mat4_mul mz my))
             "ZXY" (mat4_mul my (mat4_mul mx mz))
             :else (mat4_mul mx (mat4_mul my mz)))
           direction (fn [(v : vec3)]
             (if rotation_zero v
               [(fma matrix.r0.z v.z (fma matrix.r0.y v.y (* matrix.r0.x v.x)))
                (fma matrix.r1.z v.z (fma matrix.r1.y v.y (* matrix.r1.x v.x)))
                (fma matrix.r2.z v.z (fma matrix.r2.y v.y (* matrix.r2.x v.x)))]))]
      {:r (direction frame0.r) :p (direction frame0.p) :t (direction frame0.t)}))
)
