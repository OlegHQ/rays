; Table-driven port gate (about 30 minutes for all nodes: alias `ports`, not `runtest`). Every port_<key>.ml registers itself at start-up; the
; library is linked with -linkall so a new file needs no edit anywhere.
(library
 (name port_registry)
 (wrapped false)
 (modules :standard \ main)
 (library_flags (-linkall))
 (libraries flow flow_sop sop sop_catalog rdk rdk_test_support lisp_sop param unix))

(executable
 (name main)
 (modules main)
 (libraries port_registry))

(rule
 (alias ports)
 (deps (glob_files ../nodes/*.rays) (glob_files ../nodes/*.pending))
 (action (run %{exe:main.exe})))
